<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="Color.Window">#FFF4F4F4</Color>
      <Color x:Key="Color.WindowBorder">#FF999999</Color>
      <Color x:Key="Color.TitleBar">#FFF2F0F0</Color>
      <Color x:Key="Color.ToolBar">#FFF0F3F5</Color>
      <Color x:Key="Color.Popup">#FFFAFAFA</Color>
      <Color x:Key="Color.PopupBorder">#FFFFFFFF</Color>
      <Color x:Key="Color.Contents">#FFFFFFFF</Color>
      <Color x:Key="Color.Badge">#FFB0CEE8</Color>
      <Color x:Key="Color.BadgeFG">#FF1F1F1F</Color>
      <Color x:Key="Color.Conflict">#FF836C2E</Color>
      <Color x:Key="Color.Conflict.Foreground">#FFFFFFFF</Color>
      <Color x:Key="Color.Conflict.MineBG">#400078D7</Color>
      <Color x:Key="Color.Conflict.TheirsBG">#40FF8C00</Color>
      <Color x:Key="Color.Border0">#FFCFCFCF</Color>
      <Color x:Key="Color.Border1">#FF898989</Color>
      <Color x:Key="Color.Border2">#FFCFCFCF</Color>
      <Color x:Key="Color.FlatButton.Background">#FFF8F8F8</Color>
      <Color x:Key="Color.FlatButton.BackgroundHovered">White</Color>
      <Color x:Key="Color.FlatButton.FloatingBorder">#FF898989</Color>
      <Color x:Key="Color.FG1">#FF1F1F1F</Color>
      <Color x:Key="Color.FG2">#FF6F6F6F</Color>
      <Color x:Key="Color.Diff.EmptyBG">#10000000</Color>
      <Color x:Key="Color.Diff.AddedBG">#80BFE6C1</Color>
      <Color x:Key="Color.Diff.DeletedBG">#80FF9797</Color>
      <Color x:Key="Color.Diff.AddedHighlight">#A7E1A7</Color>
      <Color x:Key="Color.Diff.DeletedHighlight">#F19B9D</Color>
      <Color x:Key="Color.Diff.BlockBorderHighlight">DarkCyan</Color>
      <Color x:Key="Color.Link">#0000EE</Color>
      <Color x:Key="Color.InlineCode">#FFE4E4E4</Color>
      <Color x:Key="Color.InlineCodeFG">Black</Color>
      <Color x:Key="Color.SubPanel">#FFFBFBFB</Color>
      <Color x:Key="Color.AccentSurface">#0DE95420</Color>
      <Color x:Key="Color.Success">#FF257447</Color>
      <Color x:Key="Color.Warning">#FF8D5909</Color>
      <Color x:Key="Color.Danger">#FFB52E43</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Color.Window">#FF161417</Color>
      <Color x:Key="Color.WindowBorder">#1FFFFFFF</Color>
      <Color x:Key="Color.TitleBar">#FF161417</Color>
      <Color x:Key="Color.ToolBar">#FF1B191C</Color>
      <Color x:Key="Color.Popup">#FF201D21</Color>
      <Color x:Key="Color.PopupBorder">#1FFFFFFF</Color>
      <Color x:Key="Color.Contents">#FF161417</Color>
      <Color x:Key="Color.Badge">#14FFFFFF</Color>
      <Color x:Key="Color.BadgeFG">#FFF5F2F0</Color>
      <Color x:Key="Color.Conflict">#FFF1BE62</Color>
      <Color x:Key="Color.Conflict.Foreground">#FF161417</Color>
      <Color x:Key="Color.Conflict.MineBG">#403B8D7B</Color>
      <Color x:Key="Color.Conflict.TheirsBG">#40E95420</Color>
      <Color x:Key="Color.Border0">#10FFFFFF</Color>
      <Color x:Key="Color.Border1">#29FFFFFF</Color>
      <Color x:Key="Color.Border2">#14FFFFFF</Color>
      <Color x:Key="Color.FlatButton.Background">#0DFFFFFF</Color>
      <Color x:Key="Color.FlatButton.BackgroundHovered">#14FFFFFF</Color>
      <Color x:Key="Color.FlatButton.FloatingBorder">#26FFFFFF</Color>
      <Color x:Key="Color.FG1">#FFF5F2F0</Color>
      <Color x:Key="Color.FG2">#FFADA8AB</Color>
      <Color x:Key="Color.Diff.EmptyBG">#25000000</Color>
      <Color x:Key="Color.Diff.AddedBG">#8030523F</Color>
      <Color x:Key="Color.Diff.DeletedBG">#8061333A</Color>
      <Color x:Key="Color.Diff.AddedHighlight">#B03B7651</Color>
      <Color x:Key="Color.Diff.DeletedHighlight">#B093414E</Color>
      <Color x:Key="Color.Diff.BlockBorderHighlight">#FFE95420</Color>
      <Color x:Key="Color.Link">#FFF2865E</Color>
      <Color x:Key="Color.InlineCode">#0DFFFFFF</Color>
      <Color x:Key="Color.InlineCodeFG">#FFF5F2F0</Color>
      <Color x:Key="Color.SubPanel">#FF1B191C</Color>
      <Color x:Key="Color.AccentSurface">#14FFFFFF</Color>
      <Color x:Key="Color.Success">#FF80C89B</Color>
      <Color x:Key="Color.Warning">#FFF1BE62</Color>
      <Color x:Key="Color.Danger">#FFEF8A96</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Fixed logo color, independent of user-selected UI accents and themes. -->
  <SolidColorBrush x:Key="Brush.BrandOrange" Color="#FFF05032"/>

  <!-- Warm near-black surfaces, quiet white hairlines, and orange actions follow the PeerBrush website. -->
  <Color x:Key="SystemAccentColor">#FFE95420</Color>
  <Color x:Key="SystemAccentColorDark1">#FFC84314</Color>
  <Color x:Key="SystemAccentColorDark2">#FFA63810</Color>
  <Color x:Key="SystemAccentColorDark3">#FF842C0D</Color>
  <Color x:Key="SystemAccentColorLight1">#FFF27648</Color>
  <Color x:Key="SystemAccentColorLight2">#FFFFA47D</Color>
  <Color x:Key="SystemAccentColorLight3">#FFFFD2BF</Color>
  <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFE95420"/>
  <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFF26332"/>
  <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FFD84919"/>
  <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#FFE95420"/>
  <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Brush.Selection" Color="#40E95420"/>
  <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}"/>
  <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}"/>
  <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}"/>
  <SolidColorBrush x:Key="Brush.AccentSurface" Color="{DynamicResource Color.AccentSurface}"/>

  <SolidColorBrush x:Key="Brush.Window" Color="{DynamicResource Color.Window}"/>
  <SolidColorBrush x:Key="Brush.WindowBorder" Color="{DynamicResource Color.WindowBorder}"/>
  <SolidColorBrush x:Key="Brush.TitleBar" Color="{DynamicResource Color.TitleBar}"/>
  <SolidColorBrush x:Key="Brush.ToolBar" Color="{DynamicResource Color.ToolBar}"/>
  <SolidColorBrush x:Key="Brush.Popup" Color="{DynamicResource Color.Popup}"/>
  <SolidColorBrush x:Key="Brush.PopupBorder" Color="{DynamicResource Color.PopupBorder}"/>
  <SolidColorBrush x:Key="Brush.Contents" Color="{DynamicResource Color.Contents}"/>
  <SolidColorBrush x:Key="Brush.Badge" Color="{DynamicResource Color.Badge}"/>
  <SolidColorBrush x:Key="Brush.BadgeFG" Color="{DynamicResource Color.BadgeFG}"/>
  <SolidColorBrush x:Key="Brush.Conflict" Color="{DynamicResource Color.Conflict}"/>
  <SolidColorBrush x:Key="Brush.Conflict.Foreground" Color="{DynamicResource Color.Conflict.Foreground}"/>
  <SolidColorBrush x:Key="Brush.Conflict.MineBG" Color="{DynamicResource Color.Conflict.MineBG}"/>
  <SolidColorBrush x:Key="Brush.Conflict.TheirsBG" Color="{DynamicResource Color.Conflict.TheirsBG}"/>
  <SolidColorBrush x:Key="Brush.Border0" Color="{DynamicResource Color.Border0}"/>
  <SolidColorBrush x:Key="Brush.Border1" Color="{DynamicResource Color.Border1}"/>
  <SolidColorBrush x:Key="Brush.Border2" Color="{DynamicResource Color.Border2}"/>
  <SolidColorBrush x:Key="Brush.FlatButton.Background" Color="{DynamicResource Color.FlatButton.Background}"/>
  <SolidColorBrush x:Key="Brush.FlatButton.BackgroundHovered" Color="{DynamicResource Color.FlatButton.BackgroundHovered}"/>
  <SolidColorBrush x:Key="Brush.FlatButton.FloatingBorder" Color="{DynamicResource Color.FlatButton.FloatingBorder}"/>
  <SolidColorBrush x:Key="Brush.FG1" Color="{DynamicResource Color.FG1}"/>
  <SolidColorBrush x:Key="Brush.FG2" Color="{DynamicResource Color.FG2}"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource SystemAccentColor}"/>
  <SolidColorBrush x:Key="Brush.AccentHovered" Color="{DynamicResource Color.AccentSurface}"/>
  <SolidColorBrush x:Key="Brush.Diff.EmptyBG" Color="{DynamicResource Color.Diff.EmptyBG}"/>
  <SolidColorBrush x:Key="Brush.Diff.AddedBG" Color="{DynamicResource Color.Diff.AddedBG}"/>
  <SolidColorBrush x:Key="Brush.Diff.DeletedBG" Color="{DynamicResource Color.Diff.DeletedBG}"/>
  <SolidColorBrush x:Key="Brush.Diff.AddedHighlight" Color="{DynamicResource Color.Diff.AddedHighlight}"/>
  <SolidColorBrush x:Key="Brush.Diff.DeletedHighlight" Color="{DynamicResource Color.Diff.DeletedHighlight}"/>
  <SolidColorBrush x:Key="Brush.Diff.BlockBorderHighlight" Color="{DynamicResource Color.Diff.BlockBorderHighlight}"/>
  <SolidColorBrush x:Key="Brush.Link" Color="{DynamicResource Color.Link}"/>
  <SolidColorBrush x:Key="Brush.InlineCode" Color="{DynamicResource Color.InlineCode}"/>
  <SolidColorBrush x:Key="Brush.InlineCodeFG" Color="{DynamicResource Color.InlineCodeFG}"/>
  <SolidColorBrush x:Key="Brush.SubPanel" Color="{DynamicResource Color.SubPanel}"/>
</ResourceDictionary>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.DiffView"
             x:DataType="vm:DiffContext"
             CornerRadius="4"
             BorderThickness="1"
             BorderBrush="{DynamicResource Brush.Border2}">
  <Border CornerRadius="4" Background="{DynamicResource Brush.Contents}" ClipToBounds="True">
    <Grid RowDefinitions="56,*">
      <Border Grid.Row="0" Background="{DynamicResource Brush.Window}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}">
        <Grid RowDefinitions="28,28">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="8,0">
            <Path Width="12" Height="12" Data="{StaticResource Icons.File}" Fill="{DynamicResource Brush.FG2}"/>
            <v:FileModeChange Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource Brush.BadgeFG}"
                              Background="{DynamicResource Brush.Badge}" FontSize="10"
                              OldMode="{Binding OldMode, Mode=OneWay}" NewMode="{Binding NewMode, Mode=OneWay}"/>
            <TextBlock Grid.Column="2" Margin="6,0" Text="{Binding Title}" ToolTip.Tip="{Binding Title}"
                       FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <ContentControl Grid.Column="3" Content="{Binding Content, Mode=OneWay}" IsVisible="{Binding IsTextDiff}" VerticalAlignment="Center">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:TextDiffContext">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Success}" Text="{Binding Data.AddedLines, Mode=OneWay, StringFormat=+{0}}"
                               IsVisible="{Binding Data.AddedLines, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Danger}" Text="{Binding Data.DeletedLines, Mode=OneWay, StringFormat=-{0}}"
                               IsVisible="{Binding Data.DeletedLines, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"/>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="4,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnGotoFirstChange" Classes="icon_button" Width="24" Height="24" Click="OnGotoFirstChange"
                      IsVisible="{Binding IsTextDiff}" ToolTip.Tip="{OnPlatform 'First change · Ctrl+Alt+Home', macOS='First change · ⌘+⌥+Home'}">
                <Path Width="12" Height="12" Margin="0,3,0,0" Data="{StaticResource Icons.Top}"/>
              </Button>
              <Button x:Name="BtnGotoPrevChange" Classes="icon_button" Width="24" Height="24" Click="OnGotoPrevChange"
                      IsVisible="{Binding IsTextDiff}" ToolTip.Tip="{OnPlatform 'Previous change · Ctrl+Alt+Up', macOS='Previous change · ⌘+⌥+Up'}">
                <Path Width="12" Height="12" Margin="0,3,0,0" Data="{StaticResource Icons.Up}"/>
              </Button>
              <ContentControl Content="{Binding Content, Mode=OneWay}" IsVisible="{Binding IsTextDiff}" VerticalAlignment="Center" Margin="3,0">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:TextDiffContext">
                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG2}" Text="{Binding BlockNavigation.Indicator}"/>
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
              <Button x:Name="BtnGotoNextChange" Classes="icon_button" Width="24" Height="24" Click="OnGotoNextChange"
                      IsVisible="{Binding IsTextDiff}" ToolTip.Tip="{OnPlatform 'Next change · Ctrl+Alt+Down', macOS='Next change · ⌘+⌥+Down'}">
                <Path Width="12" Height="12" Margin="0,3,0,0" Data="{StaticResource Icons.Down}"/>
              </Button>
              <Button x:Name="BtnGotoLastChange" Classes="icon_button" Width="24" Height="24" Click="OnGotoLastChange"
                      IsVisible="{Binding IsTextDiff}" ToolTip.Tip="{OnPlatform 'Last change · Ctrl+Alt+End', macOS='Last change · ⌘+⌥+End'}">
                <Path Width="12" Height="12" Margin="0,3,0,0" Data="{StaticResource Icons.Bottom}"/>
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
              <ToggleButton x:Name="ToggleBtnUseSideBySide" Classes="line_path" Width="26" Height="22"
                            IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=UseSideBySideDiff, Mode=TwoWay}"
                            IsVisible="{Binding IsTextDiff}" ToolTip.Tip="Side-by-side comparison" PropertyChanged="OnToggleButtonPropertyChanged">
                <Path Width="12" Height="12" Data="{StaticResource Icons.Layout}"/>
              </ToggleButton>
              <Button x:Name="BtnOpenExternalMergeTool" Classes="icon_button" Width="26" Height="24" Command="{Binding OpenExternalMergeTool}"
                      ToolTip.Tip="{OnPlatform 'Open in diff tool · Ctrl+Shift+D', macOS='Open in diff tool · ⌘+⇧+D'}">
                <Path Width="12" Height="12" Data="{StaticResource Icons.OpenWith}"/>
              </Button>
              <Button Classes="icon_button" Width="26" Height="24" ToolTip.Tip="Diff options">
                <Path Width="14" Height="14" Data="{StaticResource Icons.More}"/>
                <Button.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="IsTextDiff"/>
                    <Binding Path="IsIgnoreWhitespaceVisible"/>
                  </MultiBinding>
                </Button.IsVisible>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel MinWidth="230" Spacing="9" Margin="4">
                      <TextBlock Text="Diff options" FontWeight="SemiBold"/>
                      <CheckBox Content="Show entire file" IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=UseFullTextDiff, Mode=TwoWay}"
                                IsVisible="{Binding IsTextDiff}" PropertyChanged="OnToggleButtonPropertyChanged"/>
                      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsTextDiff}">
                        <TextBlock Text="Context" Foreground="{DynamicResource Brush.FG2}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                          <Button Classes="flat" Height="26" MinHeight="26" Padding="8,0" Content="Less" Command="{Binding DecrUnified}">
                            <Button.IsEnabled>
                              <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="UnifiedLines" Converter="{x:Static c:IntConverters.IsGreaterThanFour}"/>
                                <Binding Source="{x:Static vm:Preferences.Instance}" Path="UseFullTextDiff" Converter="{x:Static BoolConverters.Not}"/>
                              </MultiBinding>
                            </Button.IsEnabled>
                          </Button>
                          <Button Classes="flat" Height="26" MinHeight="26" Padding="8,0" Content="More" Command="{Binding IncrUnified}"
                                  IsEnabled="{Binding Source={x:Static vm:Preferences.Instance}, Path=UseFullTextDiff, Converter={x:Static BoolConverters.Not}}"/>
                        </StackPanel>
                      </Grid>
                      <Separator IsVisible="{Binding IsTextDiff}"/>
                      <CheckBox Content="Syntax highlighting" IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=UseSyntaxHighlighting, Mode=TwoWay}"
                                IsVisible="{Binding IsTextDiff}"/>
                      <CheckBox Content="Wrap long lines" IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=EnableDiffViewWordWrap, Mode=TwoWay}">
                        <CheckBox.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsTextDiff"/>
                            <Binding Source="{x:Static vm:Preferences.Instance}" Path="UseSideBySideDiff" Converter="{x:Static BoolConverters.Not}"/>
                          </MultiBinding>
                        </CheckBox.IsVisible>
                      </CheckBox>
                      <CheckBox Content="Show whitespace symbols" IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=ShowHiddenSymbolsInDiffView, Mode=TwoWay}"
                                IsVisible="{Binding IsTextDiff}"/>
                      <CheckBox Content="Ignore whitespace changes" IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=IgnoreWhitespaceChangesInDiff, Mode=TwoWay}"
                                IsVisible="{Binding IsIgnoreWhitespaceVisible}" PropertyChanged="OnToggleButtonPropertyChanged"/>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- Diff Contents -->
      <ContentControl Grid.Row="1" Content="{Binding Content}">
        <ContentControl.DataTemplates>
          <!-- Binary Diff -->
          <DataTemplate DataType="m:BinaryDiff">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
              <TextBlock Text="Binary file"
                         Margin="0,0,0,12"
                         FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.FG2}"
                         HorizontalAlignment="Center"/>
              <Path Width="30" Height="30" Data="{StaticResource Icons.Binary}" Fill="{DynamicResource Brush.FG2}"/>
              <Grid Margin="0,12,0,0" HorizontalAlignment="Center" RowDefinitions="32,32" ColumnDefinitions="Auto,Auto">
                <Border Grid.Row="0" Grid.Column="0" Height="16" Background="{DynamicResource Brush.Badge}" CornerRadius="8" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Text.Diff.Old}" Margin="8,0" FontSize="10" Foreground="{DynamicResource Brush.BadgeFG}"/>
                </Border>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OldSize, Converter={x:Static c:LongConverters.ToFileSize}}" Foreground="{DynamicResource Brush.FG2}" HorizontalAlignment="Right" FontSize="12" Margin="8,0"/>

                <Border Grid.Row="1" Grid.Column="0" Height="16" Background="{DynamicResource Brush.Success}" CornerRadius="8" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Text.Diff.New}" Margin="8,0" FontSize="10" Foreground="{DynamicResource Brush.Window}"/>
                </Border>

                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NewSize, Converter={x:Static c:LongConverters.ToFileSize}}" Foreground="{DynamicResource Brush.FG2}" HorizontalAlignment="Right" FontSize="12" Margin="8,0"/>
              </Grid>

              <Button Classes="flat"
                      Margin="0,12,0,0"
                      HorizontalAlignment="Center"
                      Content="{DynamicResource Text.Diff.Binary.ViewContentOfNew}"
                      IsVisible="{Binding NewSize, Mode=OneWay, Converter={x:Static c:LongConverters.IsGreaterThanZero}}"
                      Click="OnOpenBinaryFileViewer"/>
            </StackPanel>
          </DataTemplate>

          <!-- LFS Diff -->
          <DataTemplate DataType="m:LFSDiff">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
              <TextBlock Text="Git LFS file"
                         Margin="0,0,0,12"
                         FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.FG2}"
                         HorizontalAlignment="Center"/>
              <Path Width="30" Height="30" Data="{StaticResource Icons.LFS}" Fill="{DynamicResource Brush.FG2}"/>
              <Grid Margin="0,12,0,0" HorizontalAlignment="Center" RowDefinitions="32,32" ColumnDefinitions="Auto,Auto">
                <Border Grid.Row="0" Grid.Column="0" Height="16" Background="{DynamicResource Brush.Badge}" CornerRadius="8" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Text.Diff.Old}" Margin="8,0" FontSize="10" Foreground="{DynamicResource Brush.BadgeFG}"/>
                </Border>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Old.Size, Converter={x:Static c:LongConverters.ToFileSize}}" Foreground="{DynamicResource Brush.FG2}" HorizontalAlignment="Right" FontSize="12" Margin="8,0"/>

                <Border Grid.Row="1" Grid.Column="0" Height="16" Background="{DynamicResource Brush.Success}" CornerRadius="8" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Text.Diff.New}" Margin="8,0" FontSize="10" Foreground="{DynamicResource Brush.Window}"/>
                </Border>

                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding New.Size, Converter={x:Static c:LongConverters.ToFileSize}}" Foreground="{DynamicResource Brush.FG2}" HorizontalAlignment="Right" FontSize="12" Margin="8,0"/>
              </Grid>
            </StackPanel>
          </DataTemplate>

          <!-- Submodule Diff -->
          <DataTemplate DataType="m:SubmoduleDiff">
            <Grid Background="{DynamicResource Brush.Contents}" RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0"
                         Text="Submodule changes"
                         Margin="8,8,8,8"
                         FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.FG2}"
                         HorizontalAlignment="Center"/>

              <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" Margin="8,0">
                  <Border Height="16" HorizontalAlignment="Center" Background="{DynamicResource Brush.Danger}" CornerRadius="8" IsVisible="{Binding New, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="{DynamicResource Text.Diff.Submodule.Deleted}" Margin="8,0" FontSize="10" Foreground="{DynamicResource Brush.Window}"/>
                  </Border>

                  <Border Margin="0,8"
                          BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
                          CornerRadius="4"
                          Background="{DynamicResource Brush.Window}"
                          IsVisible="{Binding Old, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ContentControl Content="{Binding Old}">
                      <ContentControl.DataTemplates>
                        <DataTemplate DataType="m:RevisionSubmodule">
                          <v:CommitBaseInfo Margin="0,4,8,6" Content="{Binding Commit}" FullMessage="{Binding FullMessage}"/>
                        </DataTemplate>
                      </ContentControl.DataTemplates>
                    </ContentControl>
                  </Border>

                  <Path Width="16" Height="16" Data="{StaticResource Icons.DoubleDown}" HorizontalAlignment="Center">
                    <Path.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="Old" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                        <Binding Path="New" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                      </MultiBinding>
                    </Path.IsVisible>
                  </Path>

                  <Border Height="16" HorizontalAlignment="Center" Background="{DynamicResource Brush.Success}" CornerRadius="8" IsVisible="{Binding Old, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="{DynamicResource Text.Diff.Submodule.New}" Margin="8,0" FontSize="10" Foreground="{DynamicResource Brush.Window}"/>
                  </Border>

                  <Border Margin="0,8"
                          BorderThickness="1" BorderBrush="{DynamicResource Brush.Success}"
                          CornerRadius="4"
                          Background="{DynamicResource Brush.Window}"
                          IsVisible="{Binding New, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ContentControl Content="{Binding New}">
                      <ContentControl.DataTemplates>
                        <DataTemplate DataType="m:RevisionSubmodule">
                          <StackPanel Orientation="Vertical">
                            <TextBlock Margin="0,8,0,4"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Warning}"
                                       FontFamily="{DynamicResource Fonts.Monospace}"
                                       Text="{Binding UncommittedChanges, Converter={x:Static c:StringConverters.FormatByResourceKey}, ConverterParameter='Diff.Submodule.UncommittedChanges'}"
                                       IsVisible="{Binding UncommittedChanges, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"/>
                            <v:CommitBaseInfo Margin="0,4,8,6" Content="{Binding Commit}" FullMessage="{Binding FullMessage}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ContentControl.DataTemplates>
                    </ContentControl>
                  </Border>

                  <Button Classes="flat"
                          Margin="0,8"
                          HorizontalAlignment="Center"
                          Content="{DynamicResource Text.SubmoduleRevisionCompare.OpenDetails}"
                          Click="OnOpenSubmoduleRevisionCompare"
                          IsEnabled="{Binding CanOpenDetails, Mode=OneWay}"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </DataTemplate>

          <!-- Image Diff -->
          <DataTemplate DataType="m:ImageDiff">
            <v:ImageDiffView/>
          </DataTemplate>

          <!-- LFS Image Diff -->
          <DataTemplate DataType="vm:LFSImageDiff">
            <TabControl Margin="0,8,0,0" SelectedIndex="{Binding Source={x:Static vm:Preferences.Instance}, Path=LFSImageActiveIdx, Mode=TwoWay}">
              <TabControl.Styles>
                <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
                  <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
              </TabControl.Styles>

              <TabItem>
                <TabItem.Header>
                  <TextBlock Text="LFS" FontWeight="SemiBold"/>
                </TabItem.Header>

                <ContentControl Content="{Binding LFS}"/>
              </TabItem>

              <TabItem>
                <TabItem.Header>
                  <TextBlock Text="Image" FontWeight="SemiBold"/>
                </TabItem.Header>

                <ContentControl Content="{Binding Image}"/>
              </TabItem>
            </TabControl>
          </DataTemplate>

          <!-- Text Diff -->
          <DataTemplate DataType="vm:TextDiffContext">
            <v:TextDiffView SelectedChunk="{Binding SelectedChunk, Mode=OneWay}"/>
          </DataTemplate>

          <!-- New Empty File -->
          <DataTemplate DataType="m:EmptyFile">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
              <Path Width="30" Height="30"
                    Data="{StaticResource Icons.File.Empty}"
                    Fill="{DynamicResource Brush.FG2}"/>
              <TextBlock Margin="0,12,0,0"
                         Text="Empty file"
                         FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.FG2}"
                         HorizontalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>

          <!-- Only EOL changes -->
          <DataTemplate DataType="m:NoOrEOLChange">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
              <Path Width="30" Height="30" Data="{StaticResource Icons.Check}" Fill="{DynamicResource Brush.FG2}"/>
              <TextBlock Margin="0,12,0,0"
                         Text="No changes or line-ending changes only"
                         FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.FG2}"
                         HorizontalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>
  </Border>
</UserControl>

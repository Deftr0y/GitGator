<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:v="using:SourceGit.Views"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.LauncherPage"
             x:Name="ThisControl"
             x:DataType="vm:LauncherPage">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource Brush.ToolBar}">
    <!-- ToolBar -->
    <Border Grid.Row="0"
            Height="52" IsVisible="{Binding IsRepository}"
            Background="Transparent"
            PointerPressed="OnToolBarPointerPressed">
      <ContentControl Content="{Binding Data}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:Repository">
            <v:RepositoryToolbar/>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>

    <!-- Body -->
    <Border Grid.Row="1">
      <Grid RowDefinitions="Auto,*">
        <Border Padding="14,10" Margin="12,10,12,0" CornerRadius="8" Background="{DynamicResource Brush.SubPanel}"
                BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1" IsVisible="{Binding IsUnavailable}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="3">
              <TextBlock Text="Repository unavailable" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}"/>
              <TextBlock Text="{Binding Node.Id}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding UnavailableReason}" Foreground="{DynamicResource Brush.FG2}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="flat" Height="30" Padding="14,0" Content="Retry" Command="{Binding RetryRepository}"/>
          </Grid>
        </Border>
      <ContentControl Grid.Row="1" Content="{Binding Data}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:Welcome">
            <v:Welcome Margin="4,0,4,4"
                       CornerRadius="8"
                       BorderThickness="1"
                       BorderBrush="{DynamicResource Brush.Border0}"
                       Background="{DynamicResource Brush.Window}"/>
          </DataTemplate>

          <DataTemplate DataType="vm:Repository">
            <v:Repository>
              <v:Repository.IsCommitSearchPanelVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="IsDashboardVisible"/>
                  <Binding Path="Histories.IsSearchingCommits"/>
                </MultiBinding>
              </v:Repository.IsCommitSearchPanelVisible>

              <v:Repository.IsNormalSidebarVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsDashboardVisible"/>
                    <Binding Path="Histories.IsSearchingCommits" Converter="{x:Static BoolConverters.Not}"/>
                  </MultiBinding>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsWorkingCopyVisible"/>
                    <Binding Source="{x:Static vm:Preferences.Instance}" Path="Layout.IsSidebarCollapsedInLocalChanges" Converter="{x:Static BoolConverters.Not}"/>
                  </MultiBinding>
                </MultiBinding>
              </v:Repository.IsNormalSidebarVisible>
            </v:Repository>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
      </Grid>
    </Border>

    <!-- Centered task dialogs share the website's quiet, rounded surface language. -->
    <Grid Grid.Row="1" ClipToBounds="True">
      <Grid.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="Popup" Converter="{x:Static ObjectConverters.IsNotNull}"/>
          <Binding Path="Notifications.Count" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/>
        </MultiBinding>
      </Grid.IsVisible>
      <Border Background="#88000000" PointerPressed="OnMaskClicked"
              IsVisible="{Binding Popup, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <ScrollViewer Width="600" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding Popup, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border Background="{DynamicResource Brush.Popup}" BorderThickness="1"
                BorderBrush="{DynamicResource Brush.PopupBorder}" CornerRadius="14" ClipToBounds="True">
          <ContentControl x:Name="PopupPanel" Content="{Binding Popup}" KeyboardNavigation.TabNavigation="Cycle">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:Popup">
                <StackPanel>
                  <ContentControl Margin="20,18,20,12" Content="{Binding}"
                                  IsHitTestVisible="{Binding InProgress, Converter={x:Static BoolConverters.Not}}">
                    <ContentControl.DataTemplates><v:PopupDataTemplates/></ContentControl.DataTemplates>
                  </ContentControl>
                  <ItemsControl Margin="20,0,20,12" x:CompileBindings="False"
                                ItemsSource="{Binding #ThisControl.DataContext.Notifications}"
                                IsVisible="{Binding #ThisControl.DataContext.Notifications.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="m:Notification">
                        <Border Margin="0,4" Padding="10" CornerRadius="8" Background="{DynamicResource Brush.SubPanel}"
                                BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
                          <Grid RowDefinitions="Auto,Auto">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                              <TextBlock Text="Action needs attention" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}"/>
                              <v:CopyButton Grid.Column="1" Width="18" Height="18" CopyText="{Binding Message}" ToolTip.Tip="{DynamicResource Text.Copy}"/>
                              <Button Grid.Column="2" Classes="icon_button" Width="22" Height="22" Margin="6,0,0,0" Click="OnDismissNotification" ToolTip.Tip="Dismiss">
                                <Path Width="10" Height="10" Data="{StaticResource Icons.Close}"/>
                              </Button>
                            </Grid>
                            <v:CommandLogContentPresenter Grid.Row="1" Margin="0,6,0,0" MaxHeight="140" Log="{Binding Message}"
                                                          WordWrap="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Padding="20,12,20,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border2}"
                          IsVisible="{Binding InProgress, Converter={x:Static BoolConverters.Not}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                      <Button Width="0" Height="0" Padding="0" Click="OnPopupSureByHotKey" HotKey="Enter" Focusable="False"/>
                      <Button Classes="flat" MinWidth="96" Height="32" Padding="16,0" CornerRadius="8"
                              Content="{DynamicResource Text.Cancel}" Click="OnPopupCancel" ToolTip.Tip="Esc"/>
                      <Button x:Name="PopupConfirmButton" Classes="flat primary" MinWidth="112" Height="32" Padding="16,0" CornerRadius="8"
                              Content="{Binding ConfirmText}" Click="OnPopupSure" ToolTip.Tip="Enter"/>
                    </StackPanel>
                  </Border>
                  <v:PopupRunningStatus Margin="20,8,20,16" Focusable="False" Description="{Binding ProgressDescription}"
                                        IsVisible="{Binding InProgress}" IsHitTestVisible="False"/>
                  <Button Classes="flat" Height="30" Margin="0,0,0,16" Padding="16,0" HorizontalAlignment="Center"
                          Content="{DynamicResource Text.Terminate}" Click="OnPopupTerminate">
                    <Button.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="InProgress"/><Binding Path="CanTerminate"/>
                      </MultiBinding>
                    </Button.IsVisible>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Border>
      </ScrollViewer>

      <!-- Notifications stay independent of the task dialog and keep the original copyable details. -->
      <Grid Width="520" Margin="12" HorizontalAlignment="Right" RowDefinitions="Auto,*">
        <Grid.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="Notifications.Count" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/>
            <Binding Path="Popup" Converter="{x:Static ObjectConverters.IsNull}"/>
          </MultiBinding>
        </Grid.IsVisible>
        <Button Grid.Row="0" Classes="flat" Height="26" Padding="10,0" Margin="0,0,0,4" HorizontalAlignment="Right"
                Command="{Binding ClearNotifications}" Content="{DynamicResource Text.Repository.Notifications.Clear}"/>
        <ScrollViewer Grid.Row="1" VerticalAlignment="Top" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Notifications}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="m:Notification">
                <Border Margin="0,4" Padding="12" CornerRadius="12" Background="{DynamicResource Brush.Popup}"
                        BorderThickness="1" BorderBrush="{DynamicResource Brush.PopupBorder}">
                  <Grid RowDefinitions="26,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
                      <Path Width="14" Height="14" Data="{StaticResource Icons.Error}" Fill="{DynamicResource Brush.Danger}" IsVisible="{Binding IsError}"/>
                      <Path Width="14" Height="14" Data="{StaticResource Icons.Info}" Fill="{DynamicResource Brush.Success}" IsVisible="{Binding !IsError}"/>
                      <TextBlock Grid.Column="1" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="13" Text="Action needs attention" IsVisible="{Binding IsError}"/>
                      <TextBlock Grid.Column="1" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="13" Text="GitGator" IsVisible="{Binding !IsError}"/>
                      <v:CopyButton Grid.Column="2" Width="18" Height="18" CopyText="{Binding Message}" ToolTip.Tip="{DynamicResource Text.Copy}"/>
                      <Button Grid.Column="3" Classes="icon_button" Width="22" Height="22" Margin="6,0,0,0" Click="OnDismissNotification" ToolTip.Tip="Dismiss">
                        <Path Width="10" Height="10" Data="{StaticResource Icons.Close}"/>
                      </Button>
                    </Grid>
                    <v:CommandLogContentPresenter Grid.Row="1" Margin="0,6,0,0" Padding="2" MaxHeight="220"
                                                  Log="{Binding Message, Mode=OneWay}" WordWrap="True"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.Repository"
             x:DataType="vm:Repository"
             x:Name="ThisControl">
  <UserControl.Styles>
    <Style Selector="Button.workspace_nav">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Margin" Value="8,1"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.workspace_nav TextBlock.nav_label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
    </Style>
    <Style Selector="Button.workspace_nav Path.nav_icon">
      <Setter Property="Fill" Value="{DynamicResource Brush.FG2}"/>
    </Style>
    <Style Selector="Button.workspace_nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.RowHover}"/>
    </Style>
    <Style Selector="Button.workspace_nav.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
    </Style>
    <Style Selector="Button.workspace_nav.active TextBlock.nav_label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.workspace_nav.active Path.nav_icon">
      <Setter Property="Fill" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="ToggleButton.group_expander TextBlock.group_header_label">
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.section_tool, ToggleButton.section_tool">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.section_tool Path, ToggleButton.section_tool Path">
      <Setter Property="Fill" Value="{DynamicResource Brush.FG3}"/>
    </Style>
    <Style Selector="Button.section_tool:pointerover Path, ToggleButton.section_tool:pointerover Path">
      <Setter Property="Fill" Value="{DynamicResource Brush.FG1}"/>
    </Style>
    <Style Selector="Button.section_tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.section_tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.RowHover}"/>
    </Style>
    <Style Selector="ToggleButton.section_tool:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
    </Style>
    <Style Selector="ToggleButton.section_tool:checked Path">
      <Setter Property="Fill" Value="{DynamicResource Brush.Accent}"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Body -->
    <Border Margin="4,0,4,4"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border0}"
            CornerRadius="8">
      <Border CornerRadius="8" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <!-- In-Progress Information Bar -->
          <Grid Grid.Row="0" Height="28" ColumnDefinitions="*,Auto,Auto,Auto" Background="{DynamicResource Brush.Conflict}" IsVisible="{Binding InProgressContext, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl Grid.Column="0" Margin="8,0" Content="{Binding InProgressContext}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="m:Commit">
                  <StackPanel MinWidth="400" Orientation="Vertical">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <v:Avatar Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" IsHitTestVisible="False" User="{Binding Author}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Author.Name}" Margin="8,0,0,0"/>
                      <v:DateTimePresenter Grid.Column="2"
                                           Margin="8,0,0,0"
                                           Timestamp="{Binding CommitterTime}"
                                           Foreground="{DynamicResource Brush.FG2}"/>
                    </Grid>

                    <TextBlock Margin="0,8,0,0" Text="{Binding Subject}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:CherryPickInProgress">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                      <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.CherryPick}"/>
                      <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.CherryPick.Head}"/>
                      <TextBlock FontWeight="Bold"
                                 Margin="4,0,0,0"
                                 Foreground="DarkOrange"
                                 FontFamily="{DynamicResource Fonts.Monospace}"
                                 Text="{Binding Head.SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                                 ToolTip.Tip="{Binding Head}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Classes="flat" FontWeight="Regular" BorderThickness="0" Content="{DynamicResource Text.Repository.Skip}" Padding="8,2" Click="OnSkipInProgress"/>
                  </Grid>
                </DataTemplate>

                <DataTemplate DataType="vm:RebaseInProgress">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                      <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Rebase}"/>
                      <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}"
                                 Text="{DynamicResource Text.InProgress.Rebase.StoppedAt}"
                                 IsVisible="{Binding StoppedAt, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <TextBlock FontWeight="Bold"
                                 Margin="4,0,0,0"
                                 Foreground="DarkOrange"
                                 Text="{Binding StoppedAt.SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                                 FontFamily="{DynamicResource Fonts.Monospace}"
                                 IsVisible="{Binding StoppedAt, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 ToolTip.Tip="{Binding StoppedAt}" />
                    </StackPanel>

                    <Button Grid.Column="1" Classes="flat" FontWeight="Regular" BorderThickness="0"
                            Content="{DynamicResource Text.Repository.Skip}" Padding="8,2" Click="OnSkipInProgress"
                            IsVisible="{Binding StoppedAt, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </Grid>
                </DataTemplate>

                <DataTemplate DataType="vm:RevertInProgress">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                      <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Revert}"/>
                      <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Revert.Head}"/>
                      <TextBlock FontWeight="Bold"
                                 Margin="4,0,0,0"
                                 Foreground="DarkOrange"
                                 FontFamily="{DynamicResource Fonts.Monospace}"
                                 Text="{Binding Head.SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                                 ToolTip.Tip="{Binding Head}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Classes="flat" FontWeight="Regular" BorderThickness="0" Content="{DynamicResource Text.Repository.Skip}" Padding="8,2" Click="OnSkipInProgress"/>
                  </Grid>
                </DataTemplate>

                <DataTemplate DataType="vm:MergeInProgress">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Merge}"/>
                    <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Merge.Operating}"/>
                    <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="DarkOrange" Text="{Binding SourceName}" ToolTip.Tip="{Binding Source}"/>
                    <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="→"/>
                    <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="DarkOrange" Text="{Binding Current}"/>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>

            <v:LoadingIcon Grid.Column="1"
                           Width="14" Height="14"
                           Margin="8,0"
                           IsVisible="{Binding IsSkippingOrAbortingMerge, Mode=OneWay}">
              <v:LoadingIcon.Styles>
                <Style Selector="Path">
                  <Setter Property="Fill" Value="Black"/>
                </Style>
              </v:LoadingIcon.Styles>
            </v:LoadingIcon>

            <Button Grid.Column="2"
                    Classes="flat"
                    FontWeight="Regular"
                    BorderThickness="0"
                    Content="{DynamicResource Text.Repository.Resolve}"
                    Padding="8,2" Margin="0,0,8,0"
                    Click="OnResolveInProgress"
                    IsVisible="{Binding !IsWorkingCopyVisible}"/>

            <Button Grid.Column="3"
                    Classes="flat"
                    FontWeight="Regular"
                    BorderThickness="0"
                    Content="{DynamicResource Text.Repository.Abort}"
                    Padding="8,2" Margin="0,0,8,0"
                    Click="OnAbortInProgress"/>
          </Grid>

          <!-- Main Body -->
          <Grid Grid.Row="1" Background="{DynamicResource Brush.Window}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding #ThisControl.SidebarWidth, Mode=TwoWay}" MinWidth="{Binding #ThisControl.SidebarMinWidth, Mode=OneWay}"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <!-- The sidebar shows the two everyday views and the branches; everything else waits under Advanced. -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Background="{DynamicResource Brush.SubPanel}">
              <StackPanel Grid.Row="0" Margin="0,10,0,2">
                <Button Classes="workspace_nav" Classes.active="{Binding IsWorkingCopyVisible}"
                        Tag="1" Click="OnSelectPage" IsVisible="{Binding !IsBare}"
                        ToolTip.Tip="{OnPlatform 'Changes · Ctrl+2', macOS='Changes · ⌘+2'}">
                  <Grid ColumnDefinitions="18,*,Auto,Auto">
                    <Path Grid.Column="0" Classes="nav_icon" Width="14" Height="14" Data="{StaticResource Icons.Changes}"/>
                    <TextBlock Grid.Column="1" Classes="nav_label" Margin="8,0,0,0" Text="Changes"/>
                    <Path Grid.Column="2" Width="12" Height="12" Margin="4,0"
                          Data="{StaticResource Icons.Info}" Fill="{DynamicResource Brush.Warning}"
                          IsVisible="{Binding InProgressContext, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Border Grid.Column="3" Classes="count_pill" Background="{DynamicResource Brush.Accent}"
                            IsVisible="{Binding LocalChangesCount, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                      <TextBlock Foreground="White" Text="{Binding LocalChangesCount, Converter={x:Static c:IntConverters.ToBadgeWithLimit}}"/>
                    </Border>
                  </Grid>
                </Button>
                <Button Classes="workspace_nav" Classes.active="{Binding IsDashboardVisible}"
                        Tag="0" Click="OnSelectPage"
                        ToolTip.Tip="{OnPlatform 'History · Ctrl+1', macOS='History · ⌘+1'}">
                  <Grid ColumnDefinitions="18,*">
                    <Path Grid.Column="0" Classes="nav_icon" Width="14" Height="14" Data="{StaticResource Icons.Histories}"/>
                    <TextBlock Grid.Column="1" Classes="nav_label" Margin="8,0,0,0" Text="History"/>
                  </Grid>
                </Button>
                <!-- Stashes only take a slot when there is something stashed, or when Advanced is open. -->
                <Button Classes="workspace_nav" Classes.active="{Binding IsStashesVisible}"
                        Tag="2" Click="OnSelectPage"
                        ToolTip.Tip="{OnPlatform 'Stashes · Ctrl+3', macOS='Stashes · ⌘+3'}">
                  <Button.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="!IsBare"/>
                      <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="StashesCount" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/>
                        <Binding Path="IsStashesVisible"/>
                        <Binding Source="{x:Static vm:Preferences.Instance}" Path="Layout.IsAdvancedSidebarExpanded"/>
                      </MultiBinding>
                    </MultiBinding>
                  </Button.IsVisible>
                  <Grid ColumnDefinitions="18,*,Auto">
                    <Path Grid.Column="0" Classes="nav_icon" Width="14" Height="14" Data="{StaticResource Icons.Stashes}"/>
                    <TextBlock Grid.Column="1" Classes="nav_label" Margin="8,0,0,0" Text="{DynamicResource Text.Stashes}"/>
                    <Border Grid.Column="2" Classes="count_pill"
                            IsVisible="{Binding StashesCount, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                      <TextBlock Text="{Binding StashesCount, Converter={x:Static c:IntConverters.ToBadgeWithLimit}}"/>
                    </Border>
                  </Grid>
                </Button>
              </StackPanel>

              <Grid Grid.Row="1">
                <!-- Collapsing branches leaves the navigation visible. -->
                <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding #ThisControl.IsNormalSidebarVisible, Mode=OneWay}">
                  <Grid Grid.Row="0" Height="30" Margin="18,12,8,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2"
                        Background="Transparent" ContextRequested="OnOpenSortLocalBranchMenu"
                        ToolTip.Tip="{DynamicResource Text.Repository.BranchSort}" ToolTip.ShowDelay="1200">
                    <TextBlock Grid.Column="0" Classes="eyebrow" Text="BRANCHES"/>
                    <ToggleButton Grid.Column="1" Classes="section_tool"
                                  IsChecked="{Binding #ThisControl.IsSidebarFilterVisible, Mode=TwoWay}"
                                  AutomationProperties.Name="Filter branches" ToolTip.Tip="Filter branches">
                      <Path Width="12" Height="12" Data="{StaticResource Icons.Search}"/>
                    </ToggleButton>
                    <Button Grid.Column="2" Classes="section_tool" Command="{Binding CreateNewBranch}"
                            AutomationProperties.Name="{DynamicResource Text.Repository.NewBranch}"
                            ToolTip.Tip="{DynamicResource Text.Repository.NewBranch}">
                      <Path Width="11" Height="11" Data="{StaticResource Icons.Plus}"/>
                    </Button>
                  </Grid>

                  <TextBox Grid.Row="1"
                           x:Name="FilterBox"
                           Height="28"
                           Margin="10,2,8,6"
                           BorderThickness="1"
                           CornerRadius="8"
                           IsVisible="{Binding #ThisControl.IsSidebarFilterVisible, Mode=OneWay}"
                           BorderBrush="{DynamicResource Brush.Border2}"
                           Watermark="Filter branches"
                           Text="{Binding Filter, Mode=TwoWay}"
                           VerticalContentAlignment="Center">
                    <TextBox.InnerLeftContent>
                      <Path Width="14" Height="14"
                            Margin="6,0,0,0"
                            Fill="{DynamicResource Brush.FG2}"
                            Data="{StaticResource Icons.Search}"/>
                    </TextBox.InnerLeftContent>

                    <TextBox.InnerRightContent>
                      <Button Classes="icon_button"
                              Focusable="False"
                              Width="16"
                              Margin="0,0,6,0"
                              Command="{Binding ClearFilter}"
                              IsVisible="{Binding Filter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              HorizontalAlignment="Right">
                        <Path Width="14" Height="14"
                              Margin="0,1,0,0"
                              Fill="{DynamicResource Brush.FG1}"
                              Data="{StaticResource Icons.Clear}"/>
                      </Button>
                    </TextBox.InnerRightContent>
                  </TextBox>

                  <Grid Grid.Row="2" x:Name="LeftSidebarGroups" RowDefinitions="Auto,Auto,Auto" SizeChanged="OnLeftSidebarSizeChanged">
                    <!-- Local Branches -->
                    <v:BranchTree Grid.Row="0"
                                  x:Name="LocalBranchTree"
                                  Height="0"
                                  Margin="4,0,4,0"
                                  Nodes="{Binding LocalBranchTrees}"
                                  SelectionChanged="OnLocalBranchTreeSelectionChanged"
                                  RowsChanged="OnLeftSidebarRowsChanged"
                                  SearchRequested="OnToggleSidebarFilter"/>

                    <!-- Remotes, tags, submodules and worktrees are for the rare technical task. -->
                    <ToggleButton Grid.Row="1" x:Name="AdvancedToggle" Classes="group_expander" Height="32" Margin="14,8,0,0"
                                  IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.IsAdvancedSidebarExpanded, Mode=TwoWay}"
                                  IsCheckedChanged="OnAdvancedSidebarToggled"
                                  ToolTip.Tip="Stashes, remotes, tags, submodules and worktrees">
                      <TextBlock Classes="eyebrow" Text="ADVANCED"/>
                    </ToggleButton>

                    <Grid Grid.Row="2" x:Name="AdvancedGroups" RowDefinitions="28,Auto,28,Auto,28,Auto,28,Auto"
                          IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.IsAdvancedSidebarExpanded, Mode=OneWay}">
                      <!-- Remotes -->
                      <ToggleButton Grid.Row="0" Classes="group_expander" IsChecked="{Binding IsRemoteGroupExpanded, Mode=TwoWay}">
                        <Grid ColumnDefinitions="16,*,Auto,Auto">
                          <Path Grid.Column="0" Width="11" Height="11" HorizontalAlignment="Left" Data="{StaticResource Icons.Remotes}" Fill="{DynamicResource Brush.FG2}"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.Remotes}"/>
                            <TextBlock Classes="group_header_label" Text="{Binding Remotes, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
                          </StackPanel>
                          <Button Grid.Column="2"
                                  Classes="icon_button"
                                  Width="14"
                                  Margin="8,0,0,0"
                                  Click="OnOpenSortRemoteBranchMenu"
                                  ToolTip.Tip="{DynamicResource Text.Repository.BranchSort}">
                            <Grid>
                              <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByName}" IsVisible="{Binding IsSortingRemoteBranchByName, Mode=OneWay}"/>
                              <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByTime}" IsVisible="{Binding !IsSortingRemoteBranchByName, Mode=OneWay}"/>
                            </Grid>
                          </Button>
                          <Button Grid.Column="3" Classes="icon_button" Width="14" Margin="8,0" Command="{Binding AddRemote}" ToolTip.Tip="{DynamicResource Text.Repository.Remotes.Add}">
                            <Path Width="12" Height="12" Data="{StaticResource Icons.Remote.Add}"/>
                          </Button>
                        </Grid>
                      </ToggleButton>
                      <v:BranchTree Grid.Row="1"
                                    x:Name="RemoteBranchTree"
                                    Height="0"
                                    Margin="6,0,4,0"
                                    Nodes="{Binding RemoteBranchTrees}"
                                    IsVisible="{Binding IsRemoteGroupExpanded}"
                                    SelectionChanged="OnRemoteBranchTreeSelectionChanged"
                                    RowsChanged="OnLeftSidebarRowsChanged"
                                    SearchRequested="OnToggleSidebarFilter"/>

                      <!-- Tags -->
                      <ToggleButton Grid.Row="2" Classes="group_expander" IsChecked="{Binding IsTagGroupExpanded, Mode=TwoWay}">
                        <Grid ColumnDefinitions="16,*,Auto,Auto,Auto">
                          <Path Grid.Column="0" Width="11" Height="11" Margin="0,1,0,0" HorizontalAlignment="Left" Data="{StaticResource Icons.Tags}" Fill="{DynamicResource Brush.FG2}"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.Tags}"/>
                            <TextBlock Classes="group_header_label" Text="{Binding Tags, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
                          </StackPanel>
                          <ToggleButton Grid.Column="2"
                                        Classes="line_path"
                                        Width="14"
                                        IsChecked="{Binding ShowTagsAsTree, Mode=TwoWay}"
                                        ToolTip.Tip="{DynamicResource Text.Repository.ShowTagsAsTree}">
                            <Path Width="11" Height="11" Data="{DynamicResource Icons.Tree}"/>
                          </ToggleButton>
                          <Button Grid.Column="3"
                                  Classes="icon_button"
                                  Width="14"
                                  Margin="8,0,0,0"
                                  Click="OnOpenSortTagMenu"
                                  ToolTip.Tip="{DynamicResource Text.Repository.Tags.Sort}">
                            <Grid>
                              <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByName}" IsVisible="{Binding IsSortingTagsByName, Mode=OneWay}"/>
                              <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByTime}" IsVisible="{Binding !IsSortingTagsByName, Mode=OneWay}"/>
                            </Grid>
                          </Button>
                          <Button Grid.Column="4"
                                  Classes="icon_button"
                                  Width="14"
                                  Margin="8,0"
                                  Command="{Binding CreateNewTag}"
                                  ToolTip.Tip="{DynamicResource Text.Repository.Tags.Add}">
                            <Path Width="12" Height="12" Data="{StaticResource Icons.Tag.Add}"/>
                          </Button>
                        </Grid>
                      </ToggleButton>
                      <v:TagsView Grid.Row="3"
                                  x:Name="TagsList"
                                  Height="0"
                                  Margin="6,0,4,0"
                                  Background="Transparent"
                                  Content="{Binding VisibleTags}"
                                  Focusable="False"
                                  IsVisible="{Binding IsTagGroupExpanded, Mode=OneWay}"
                                  SelectionChanged="OnTagsSelectionChanged"
                                  RowsChanged="OnLeftSidebarRowsChanged"
                                  SearchRequested="OnToggleSidebarFilter"/>

                      <!-- Submodules -->
                      <ToggleButton Grid.Row="4" Classes="group_expander" IsChecked="{Binding IsSubmoduleGroupExpanded, Mode=TwoWay}">
                        <Grid ColumnDefinitions="16,*,Auto,Auto,Auto">
                          <Path Grid.Column="0" Width="11" Height="11" HorizontalAlignment="Left" Data="{StaticResource Icons.Submodules}" Fill="{DynamicResource Brush.FG2}"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.Submodules}"/>
                            <TextBlock Classes="group_header_label" Text="{Binding Submodules, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
                          </StackPanel>
                          <ToggleButton Grid.Column="2"
                                        Classes="line_path"
                                        Width="14"
                                        IsChecked="{Binding ShowSubmodulesAsTree, Mode=TwoWay}"
                                        IsVisible="{Binding Submodules, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"
                                        ToolTip.Tip="{DynamicResource Text.Repository.ShowSubmodulesAsTree}">
                            <Path Width="11" Height="11" Data="{DynamicResource Icons.Tree}"/>
                          </ToggleButton>
                          <Button Grid.Column="3"
                                  Classes="icon_button"
                                  Width="14"
                                  Margin="8,0"
                                  Command="{Binding UpdateSubmodules}"
                                  IsVisible="{Binding Submodules, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"
                                  ToolTip.Tip="{DynamicResource Text.Repository.Submodules.Update}">
                            <Path Width="12" Height="12" Data="{StaticResource Icons.Loading}"/>
                          </Button>
                          <Button Grid.Column="4"
                                  Classes="icon_button"
                                  Width="14"
                                  Margin="0,0,8,0"
                                  Command="{Binding AddSubmodule}"
                                  ToolTip.Tip="{DynamicResource Text.Repository.Submodules.Add}">
                            <Path Width="12" Height="12" Data="{StaticResource Icons.Submodule.Add}"/>
                          </Button>
                        </Grid>
                      </ToggleButton>
                      <v:SubmodulesView Grid.Row="5"
                                        x:Name="SubmoduleList"
                                        Height="0"
                                        Margin="6,0,4,0"
                                        Content="{Binding VisibleSubmodules}"
                                        RowsChanged="OnLeftSidebarRowsChanged"
                                        Focusable="False"
                                        IsVisible="{Binding IsSubmoduleGroupExpanded, Mode=OneWay}"
                                        SearchRequested="OnToggleSidebarFilter"/>

                      <!-- Worktrees -->
                      <ToggleButton Grid.Row="6" Classes="group_expander" IsChecked="{Binding IsWorktreeGroupExpanded, Mode=TwoWay}">
                        <Grid ColumnDefinitions="16,*,Auto,Auto">
                          <Path Grid.Column="0" Width="11" Height="11" HorizontalAlignment="Left" Data="{StaticResource Icons.Worktrees}" Fill="{DynamicResource Brush.FG2}"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.Worktrees}"/>
                            <TextBlock Classes="group_header_label" Text="{Binding Worktrees, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
                          </StackPanel>
                          <Button Grid.Column="2"
                                  Classes="icon_button"
                                  Width="14"
                                  Margin="8,0"
                                  Click="OnPruneWorktrees"
                                  IsVisible="{Binding Worktrees, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"
                                  ToolTip.Tip="{DynamicResource Text.Repository.Worktrees.Prune}">
                            <Path Width="12" Height="12" Data="{StaticResource Icons.Loading}"/>
                          </Button>
                          <Button Grid.Column="3"
                                  Classes="icon_button"
                                  Width="14"
                                  Margin="0,0,9,0"
                                  Command="{Binding AddWorktree}"
                                  ToolTip.Tip="{DynamicResource Text.Repository.Worktrees.Add}"
                                  ToolTip.Placement="Right">
                            <Path Width="11" Height="11" Data="{StaticResource Icons.Worktree.Add}"/>
                          </Button>
                        </Grid>
                      </ToggleButton>
                      <ListBox Grid.Row="7"
                               x:Name="WorktreeList"
                               Height="0"
                               Margin="6,0,4,0"
                               Classes="repo_left_content_list"
                               ItemsSource="{Binding Worktrees, Mode=OneWay}"
                               SelectionMode="Single"
                               PropertyChanged="OnWorktreeListPropertyChanged"
                               IsVisible="{Binding IsWorktreeGroupExpanded, Mode=OneWay}">
                        <ListBox.Styles>
                          <Style Selector="ListBoxItem">
                            <Setter Property="CornerRadius" Value="4"/>
                          </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                          <DataTemplate DataType="vm:Worktree">
                            <Border Height="28"
                                    Background="Transparent"
                                    DoubleTapped="OnWorktreeDoubleTapped"
                                    ContextRequested="OnWorktreeContextRequested"
                                    ToolTip.Placement="Right">
                              <ToolTip.Tip>
                                <StackPanel Orientation="Vertical">
                                  <StackPanel Orientation="Horizontal">
                                    <v:WorktreeIcon Width="12" Height="12"/>
                                    <TextBlock FontWeight="Bold" Margin="8,0,0,0" Text="{Binding Name, Mode=OneWay}"/>
                                  </StackPanel>

                                  <Grid RowDefinitions="24,24,24" ColumnDefinitions="Auto,16,Auto,Auto" Margin="0,8,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Classes="info_label"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Text="{DynamicResource Text.Worktree.Branch}"/>
                                    <Path Grid.Row="0" Grid.Column="2"
                                          Width="14" Height="14"
                                          Margin="2,0,0,0"
                                          Data="{StaticResource Icons.Branch}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3"
                                               Margin="6,0,0,0"
                                               Text="{Binding Branch, Mode=OneWay}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Classes="info_label"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Text="{DynamicResource Text.Worktree.Path}"/>
                                    <Path Grid.Row="1" Grid.Column="2"
                                          Width="14" Height="14"
                                          Margin="2,0,0,0"
                                          Data="{StaticResource Icons.Folder.Open}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3"
                                               Margin="6,0,0,0"
                                               Text="{Binding FullPath, Mode=OneWay}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Classes="info_label"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Text="{DynamicResource Text.Worktree.Head}"/>
                                    <Path Grid.Row="2" Grid.Column="2"
                                          Width="14" Height="14"
                                          Data="{StaticResource Icons.Commit}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3"
                                               Margin="6,0,0,0"
                                               Text="{Binding Head, Mode=OneWay, Converter={x:Static c:StringConverters.ToShortSHA}}"/>
                                  </Grid>
                                </StackPanel>
                              </ToolTip.Tip>
                              <Grid ColumnDefinitions="9,Auto,Auto,*,22" VerticalAlignment="Center">
                                <v:WorktreeDepthIcon Grid.Column="1" Brush="{DynamicResource Brush.Border1}"/>
                                <v:WorktreeIcon Grid.Column="2"
                                                Width="10" Height="10"
                                                Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="3"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource Brush.FG2}"
                                           TextTrimming="CharacterEllipsis">
                                  <Run Text="{Binding Name, Mode=OneWay}"
                                       FontWeight="{Binding IsCurrent, Mode=OneWay, Converter={x:Static c:BoolConverters.IsBoldToFontWeight}}"
                                       Foreground="{DynamicResource Brush.FG1}"/>
                                  <Run Text="{Binding DisplayPath, Mode=OneWay}"/>
                                </TextBlock>
                                <Path Grid.Column="4"
                                      Width="10" Height="10"
                                      Margin="4,0,0,0"
                                      Data="{StaticResource Icons.Lock}"
                                      Fill="{DynamicResource Brush.FG2}"
                                      IsVisible="{Binding IsLocked, Mode=OneWay}"/>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Grid>
                  </Grid>
                </Grid>

                <!-- Commit Search Panel -->
                <v:CommitSearchView Grid.Column="0"
                                    Margin="6,0,4,0"
                                    DataContext="{Binding Histories.SearchCommitContext, Mode=OneWay}"
                                    IsVisible="{Binding #ThisControl.IsCommitSearchPanelVisible, Mode=OneWay}"/>
              </Grid>

              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,8,8">
                <Button Grid.Column="0" Classes="workspace_nav" Click="OnOpenConfigure"
                        ToolTip.Tip="{DynamicResource Text.Repository.Configure}">
                  <Grid ColumnDefinitions="18,*">
                    <Path Grid.Column="0" Classes="nav_icon" Width="13" Height="13" Data="{StaticResource Icons.Settings}"/>
                    <TextBlock Grid.Column="1" Classes="nav_label" Margin="8,0,0,0" Text="Settings"/>
                  </Grid>
                </Button>
                <ToggleButton Grid.Column="1" x:Name="BranchSidebarToggle" Classes="sidebar_expander" Width="28" Height="28"
                              IsVisible="{Binding IsWorkingCopyVisible}"
                              IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.IsSidebarCollapsedInLocalChanges, Mode=TwoWay}"
                              AutomationProperties.Name="Show or hide branches"/>
              </Grid>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="3" MinWidth="3" MaxWidth="3"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0,0,1,0"
                          BorderBrush="{DynamicResource Brush.Border0}"
                          Focusable="False"/>

            <!-- Right Page -->
            <Grid Grid.Column="2">
              <!-- Dashboard (History) Page -->
              <Border IsVisible="{Binding IsDashboardVisible, Mode=OneWay}" PropertyChanged="OnRightPagePropertyChanged">
                <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource Brush.SubPanel}">
                  <!-- Bisect Information Bar -->
                  <Grid Grid.Row="0"
                        Height="28"
                        ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
                        Background="{DynamicResource Brush.Conflict}"
                        IsVisible="{Binding BisectState, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static m:BisectState.None}}">
                    <TextBlock Grid.Column="0"
                               FontWeight="Bold"
                               Margin="8,0"
                               Foreground="{DynamicResource Brush.Conflict.Foreground}"
                               Text="{DynamicResource Text.Bisect.WaitingForFirstBad}"
                               IsVisible="{Binding BisectState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:BisectState.WaitingForFirstBad}}"/>

                    <TextBlock Grid.Column="0"
                               FontWeight="Bold"
                               Margin="8,0"
                               Foreground="{DynamicResource Brush.Conflict.Foreground}"
                               Text="{DynamicResource Text.Bisect.WaitingForCheckoutAnother}"
                               IsVisible="{Binding BisectState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:BisectState.WaitingForCheckoutAnother}}"/>

                    <TextBlock Grid.Column="0"
                               FontWeight="Bold"
                               Margin="8,0"
                               Foreground="{DynamicResource Brush.Conflict.Foreground}"
                               Text="{DynamicResource Text.Bisect.WaitingForFirstGood}"
                               IsVisible="{Binding BisectState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:BisectState.WaitingForFirstGood}}"/>

                    <TextBlock Grid.Column="0"
                               FontWeight="Bold"
                               Margin="8,0"
                               Foreground="{DynamicResource Brush.Conflict.Foreground}"
                               Text="{DynamicResource Text.Bisect.WaitingForMark}"
                               IsVisible="{Binding BisectState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:BisectState.WaitingForMark}}"/>

                    <v:LoadingIcon Grid.Column="1"
                                   Width="14" Height="14"
                                   Margin="4,0"
                                   IsVisible="{Binding IsBisectCommandRunning}"/>

                    <Button Grid.Column="2"
                            Classes="flat"
                            Margin="4,0"
                            FontWeight="Regular"
                            BorderThickness="0"
                            Content="{DynamicResource Text.Bisect.Bad}"
                            Padding="8,2"
                            Click="OnBisectCommand"
                            Tag="bad">
                      <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="IsBisectCommandRunning" Converter="{x:Static BoolConverters.Not}"/>
                          <Binding Path="BisectState" Converter="{x:Static ObjectConverters.NotEqual}" ConverterParameter="{x:Static m:BisectState.WaitingForCheckoutAnother}"/>
                        </MultiBinding>
                      </Button.IsEnabled>
                    </Button>
                    <Button Grid.Column="3"
                            Classes="flat"
                            Margin="4,0"
                            FontWeight="Regular"
                            BorderThickness="0"
                            Content="{DynamicResource Text.Bisect.Good}"
                            Padding="8,2"
                            Click="OnBisectCommand"
                            Tag="good">
                      <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="IsBisectCommandRunning" Converter="{x:Static BoolConverters.Not}"/>
                          <Binding Path="BisectState" Converter="{x:Static ObjectConverters.NotEqual}" ConverterParameter="{x:Static m:BisectState.WaitingForFirstBad}"/>
                          <Binding Path="BisectState" Converter="{x:Static ObjectConverters.NotEqual}" ConverterParameter="{x:Static m:BisectState.WaitingForCheckoutAnother}"/>
                        </MultiBinding>
                      </Button.IsEnabled>
                    </Button>
                    <Button Grid.Column="4"
                            Classes="flat"
                            Margin="4,0"
                            FontWeight="Regular"
                            BorderThickness="0"
                            Content="{DynamicResource Text.Bisect.Skip}"
                            IsVisible="{Binding BisectState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:BisectState.WaitingForMark}}"
                            IsEnabled="{Binding !IsBisectCommandRunning}"
                            Padding="8,2"
                            Click="OnBisectCommand"
                            Tag="skip"/>
                    <Button Grid.Column="5"
                            Classes="flat"
                            Margin="4,0"
                            FontWeight="Regular"
                            BorderThickness="0"
                            Content="{DynamicResource Text.Bisect.Abort}"
                            IsEnabled="{Binding !IsBisectCommandRunning}"
                            Padding="8,2"
                            Click="OnBisectCommand"
                            Tag="reset"/>
                  </Grid>

                  <!-- History Filter Bar -->
                  <Border Grid.Row="1"
                          Background="{DynamicResource Brush.Popup}"
                          BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
                          IsVisible="{Binding UIStates.HistoryFilters.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <Path Grid.Column="0"
                            Margin="8,0,0,0"
                            Width="12" Height="12"
                            Data="{StaticResource Icons.Filter}"
                            Fill="{DynamicResource Brush.FG2}"
                            IsVisible="{Binding HistoryFilterMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:FilterMode.Included}}"/>
                      <Path Grid.Column="0"
                            Margin="8,0,0,0"
                            Width="12" Height="12"
                            Data="{StaticResource Icons.EyeClose}"
                            Fill="{DynamicResource Brush.FG2}"
                            IsVisible="{Binding HistoryFilterMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:FilterMode.Excluded}}"/>

                      <ItemsControl Grid.Column="1"
                                    Margin="8,4"
                                    ItemsSource="{Binding UIStates.HistoryFilters}"
                                    IsVisible="{Binding !IsHistoryFiltersCollapsed, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemHeight="22"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="m:HistoryFilter">
                            <Border Height="20"
                                    Margin="0,0,6,0"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{Binding Mode, Converter={x:Static c:FilterModeConverters.ToBorderBrush}}"
                                    VerticalAlignment="Center">
                              <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="Auto" MaxWidth="480"/>
                                  <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <v:HistoryFilterIcon Grid.Column="0"
                                                     Width="12" Height="12"
                                                     VerticalAlignment="Center"
                                                     Filter="{Binding Mode=OneWay}"
                                                     IsFilterValid="{Binding IsValid, Mode=OneWay}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Pattern, Converter={x:Static c:StringConverters.TrimRefsPrefix}}"
                                           Margin="4,0,8,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <Button Grid.Column="2" Classes="icon_button" VerticalAlignment="Center" Margin="0" Padding="0" Click="OnRemoveSelectedHistoryFilter">
                                  <Path Width="8" Height="8" Data="{StaticResource Icons.Close}"/>
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Border Grid.Column="1"
                              Height="30"
                              Margin="6,0,0,0"
                              IsVisible="{Binding IsHistoryFiltersCollapsed, Mode=OneWay}">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}">
                          <Run Text="{Binding UIStates.HistoryFilters.Count, Mode=OneWay}" FontWeight="Bold"/>
                          <Run Text="{DynamicResource Text.Repository.FilterCommits.Summary}"/>
                        </TextBlock>
                      </Border>

                      <ToggleButton Grid.Column="2"
                                    Classes="filter_expander"
                                    Width="20"
                                    Margin="16,0,0,0"
                                    Background="Transparent"
                                    IsChecked="{Binding IsHistoryFiltersCollapsed, Mode=TwoWay}"/>

                      <Button Grid.Column="3"
                              Width="20"
                              Margin="0,0,12,0"
                              Classes="icon_button"
                              Command="{Binding ClearHistoryFilters}"
                              ToolTip.Tip="{DynamicResource Text.Repository.ClearAllCommitsFilter}">
                        <Path Width="14" Height="14" Margin="0,1,0,0" Data="{StaticResource Icons.RemoveAll}"/>
                      </Button>
                    </Grid>
                  </Border>

                  <!-- History -->
                  <v:Histories Grid.Row="2"
                               DataContext="{Binding Histories, Mode=OneWay}"
                               CurrentBranch="{Binding CurrentBranch, Mode=OneWay}"
                               Bisect="{Binding Bisect, Mode=OneWay}"
                               HasSingleRemote="{Binding HasSingleRemote, Mode=OneWay}"
                               IssueTrackers="{Binding IssueTrackers, Mode=OneWay}">
                    <v:Histories.IsDetailsPanelExpanded>
                      <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Source="{x:Static vm:Preferences.Instance}" Path="UseTwoColumnsLayoutInHistories" Mode="OneWay"/>
                        <Binding Path="IsCollapseDetails" Converter="{x:Static BoolConverters.Not}" Mode="OneWay"/>
                      </MultiBinding>
                    </v:Histories.IsDetailsPanelExpanded>
                  </v:Histories>
                </Grid>
              </Border>

              <!-- Local Changes Page -->
              <Border IsVisible="{Binding IsWorkingCopyVisible, Mode=OneWay}" PropertyChanged="OnRightPagePropertyChanged">
                <v:WorkingCopy DataContext="{Binding WorkingCopy, Mode=OneWay}"/>
              </Border>

              <!-- Stashes Page -->
              <Border IsVisible="{Binding IsStashesVisible, Mode=OneWay}" PropertyChanged="OnRightPagePropertyChanged">
                <v:StashesPage DataContext="{Binding StashesPage, Mode=OneWay}"/>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>

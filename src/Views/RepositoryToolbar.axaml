<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="52"
             x:Class="SourceGit.Views.RepositoryToolbar"
             x:DataType="vm:Repository"
             x:Name="ThisControl">
  <UserControl.Styles>
    <!-- The branch reads as a pill: it is where you are, and a click changes it. -->
    <Style Selector="Button.branch_pill">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    </Style>
    <Style Selector="Button.branch_pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border1}"/>
    </Style>
    <Style Selector="Button.header_icon">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.header_icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.BackgroundHovered}"/>
    </Style>
    <Style Selector="Button.sync">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="MinWidth" Value="104"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
  </UserControl.Styles>

  <!-- One line answers: which branch am I on, is it in sync, and what is the next step. -->
  <Grid ColumnDefinitions="Auto,*,Auto,Auto,0" Margin="12,0,10,0" ColumnSpacing="10">
    <Button Grid.Column="0" x:Name="BranchButton" Classes="branch_pill" Click="OpenBranchMenu"
            AutomationProperties.Name="Current branch" ToolTip.Tip="Switch or create a branch">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Path Width="13" Height="13" Data="{StaticResource Icons.Branch}" Fill="{DynamicResource Brush.Accent}"/>
        <TextBlock Text="{Binding CurrentBranch?.Name, TargetNullValue='No branch yet'}" FontWeight="SemiBold"
                   MaxWidth="280" TextTrimming="CharacterEllipsis"/>
        <Path Width="9" Height="9" Margin="0,1,0,0" Data="{StaticResource Icons.Down}" Fill="{DynamicResource Brush.FG2}"/>
      </StackPanel>
    </Button>

    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="6,0,0,0" ClipToBounds="True">
      <Ellipse x:Name="SyncDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Brush.FG3}"/>
      <TextBlock x:Name="SyncStatus" Classes="muted" TextTrimming="CharacterEllipsis"/>
    </StackPanel>

    <Button Grid.Column="2" x:Name="SyncButton" Classes="flat sync" Tapped="OnSync">
      <ToolTip.Tip>
        <StackPanel>
          <TextBlock x:Name="SyncTip"/>
          <TextBlock Classes="small" Margin="0,4,0,0" Text="Ctrl+click to choose options first" Foreground="{DynamicResource Brush.FG2}"/>
        </StackPanel>
      </ToolTip.Tip>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Path x:Name="SyncIcon" Width="13" Height="13"/>
        <TextBlock x:Name="SyncLabel"/>
      </StackPanel>
    </Button>

    <Button Grid.Column="3" x:Name="MoreButton" Classes="header_icon" AutomationProperties.Name="More actions" ToolTip.Tip="More actions">
      <Path Width="15" Height="15" Data="{StaticResource Icons.More}"/>
      <Button.Flyout>
        <MenuFlyout Placement="BottomEdgeAlignedRight">
          <MenuItem Header="Fetch…" Click="FetchWithOptions"/>
          <MenuItem Header="Pull…" Click="PullWithOptions" IsVisible="{Binding !IsBare}"/>
          <MenuItem Header="Push…" Click="PushWithOptions"/>
          <MenuItem Header="-"/>
          <MenuItem Header="{DynamicResource Text.Repository.NewBranch}" Command="{Binding CreateNewBranch}" InputGesture="{OnPlatform Ctrl+B, macOS=⌘+B}"/>
          <MenuItem Header="{DynamicResource Text.Stash}" Click="StashFromMore" IsVisible="{Binding !IsBare}"/>
          <MenuItem Header="{DynamicResource Text.Apply.Title}" Command="{Binding ApplyPatch}" IsVisible="{Binding !IsBare}"/>
          <MenuItem Header="-"/>
          <MenuItem Header="{DynamicResource Text.Repository.OpenWithExternalTools}" Click="OpenExternalToolsFromMore"/>
          <MenuItem Header="{DynamicResource Text.Repository.ViewLogs}" Click="OpenGitLogs"/>
          <MenuItem Header="{DynamicResource Text.Repository.Statistics}" Click="OpenStatistics"/>
          <MenuItem Header="{DynamicResource Text.Repository.CustomActions}" Click="OpenCustomActionsFromMore"/>
          <MenuItem Header="-"/>
          <MenuItem Header="{DynamicResource Text.GitLFS}" Click="OpenGitLFSFromMore" IsVisible="{Binding !IsBare}"/>
          <MenuItem Header="{DynamicResource Text.GitFlow}" Click="OpenGitFlowFromMore" IsVisible="{Binding !IsBare}"/>
          <MenuItem Header="{DynamicResource Text.Bisect}" Click="StartBisect" IsVisible="{Binding !IsBare}"/>
          <MenuItem Header="{DynamicResource Text.Repository.Clean}" Click="Cleanup"/>
        </MenuFlyout>
      </Button.Flyout>
    </Button>

    <!-- Existing direct-action shortcuts stay available without adding toolbar controls. -->
    <StackPanel Grid.Column="4" Orientation="Horizontal">
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
      <Button Width="0" Height="0" Command="{Binding CreateNewBranch}" IsVisible="False" HotKey="{OnPlatform Ctrl+B, macOS=⌘+B}"/>
    </StackPanel>
  </Grid>
</UserControl>

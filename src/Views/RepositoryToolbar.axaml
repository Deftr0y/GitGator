<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="36"
             x:Class="SourceGit.Views.RepositoryToolbar"
             x:DataType="vm:Repository">
  <UserControl.Styles>
    <Style Selector="Button.repo_action">
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.repo_action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.BackgroundHovered}"/>
    </Style>
    <Style Selector="TextBlock.action_count">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="1,0,0,0"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*,Auto,0" Margin="8,0">
    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
      <Button Classes="repo_action" Tapped="Fetch">
        <ToolTip.Tip>
          <StackPanel>
            <TextBlock Text="{DynamicResource Text.Fetch}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Fetch}"/>
          <TextBlock Text="{DynamicResource Text.Fetch}"/>
        </StackPanel>
      </Button>
      <Button Classes="repo_action" Tapped="Pull" IsVisible="{Binding !IsBare}" IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel>
            <TextBlock Text="{DynamicResource Text.Pull}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="12" Height="13" Data="M5 0H7V9L10 6L11.4 7.4L6 12.8L0.6 7.4L2 6L5 9Z"/>
          <TextBlock Text="{DynamicResource Text.Pull}"/>
          <TextBlock Classes="action_count" Text="{Binding CurrentBranch?.Behind, Converter={x:Static c:ListConverters.ToCount}}"
                     IsVisible="{Binding CurrentBranch?.Behind, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Button>
      <Button Classes="repo_action" Tapped="Push">
        <ToolTip.Tip>
          <StackPanel>
            <TextBlock Text="{DynamicResource Text.Push}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="12" Height="13" Data="M5 13H7V4L10 7L11.4 5.6L6 0.2L0.6 5.6L2 7L5 4Z"/>
          <TextBlock Text="{DynamicResource Text.Push}"/>
          <TextBlock Classes="action_count" Text="{Binding CurrentBranch?.Ahead, Converter={x:Static c:ListConverters.ToCount}}"
                     IsVisible="{Binding CurrentBranch?.Ahead, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <Button Grid.Column="2" x:Name="MoreButton" Classes="repo_action" ToolTip.Tip="More repository actions">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Path Width="14" Height="14" Data="{StaticResource Icons.More}"/>
        <TextBlock Text="More"/>
      </StackPanel>
      <Button.Flyout>
        <MenuFlyout Placement="BottomEdgeAlignedRight">
          <MenuItem Header="{DynamicResource Text.Repository.NewBranch}" Command="{Binding CreateNewBranch}" InputGesture="{OnPlatform Ctrl+B, macOS=⌘+B}"/>
          <MenuItem Header="{DynamicResource Text.Stash}" Click="StashFromMore" IsVisible="{Binding !IsBare}"/>
          <MenuItem Header="{DynamicResource Text.Apply.Title}" Command="{Binding ApplyPatch}" IsVisible="{Binding !IsBare}"/>
          <MenuItem Header="-"/>
          <MenuItem Header="{DynamicResource Text.Repository.OpenWithExternalTools}" Click="OpenExternalToolsFromMore"/>
          <MenuItem Header="{DynamicResource Text.Repository.ViewLogs}" Click="OpenGitLogs"/>
          <MenuItem Header="{DynamicResource Text.Repository.Statistics}" Click="OpenStatistics"/>
          <MenuItem Header="{DynamicResource Text.Repository.CustomActions}" Click="OpenCustomActionsFromMore"/>
          <MenuItem Header="-"/>
          <MenuItem Header="{DynamicResource Text.GitLFS}" Click="OpenGitLFSFromMore" IsVisible="{Binding !IsBare}"/>
          <MenuItem Header="{DynamicResource Text.GitFlow}" Click="OpenGitFlowFromMore" IsVisible="{Binding !IsBare}"/>
          <MenuItem Header="{DynamicResource Text.Bisect}" Click="StartBisect" IsVisible="{Binding !IsBare}"/>
          <MenuItem Header="{DynamicResource Text.Repository.Clean}" Click="Cleanup"/>
        </MenuFlyout>
      </Button.Flyout>
    </Button>

    <!-- Existing direct-action shortcuts stay available without adding toolbar controls. -->
    <StackPanel Grid.Column="3" Orientation="Horizontal">
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
      <Button Width="0" Height="0" Command="{Binding CreateNewBranch}" IsVisible="False" HotKey="{OnPlatform Ctrl+B, macOS=⌘+B}"/>
    </StackPanel>
  </Grid>
</UserControl>

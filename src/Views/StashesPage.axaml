<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="SourceGit.Views.StashesPage"
             x:DataType="vm:StashesPage">
  <Grid SizeChanged="OnMainLayoutSizeChanged" Background="{DynamicResource Brush.Contents}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.StashesLeftWidth, Mode=TwoWay}" MinWidth="260"/>
      <ColumnDefinition Width="4"/>
      <ColumnDefinition Width="*" MinWidth="320"/>
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" RowDefinitions="52,36,*,40,*" Background="{DynamicResource Brush.Window}">
      <Border Grid.Row="0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="16,0,10,0" ColumnSpacing="8">
          <TextBlock Classes="page_title" Text="Stashes"/>
          <Border Grid.Column="1" Classes="count_pill" IsVisible="{Binding Stashes, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Stashes.Count}"/>
          </Border>
          <Button Grid.Column="3" Classes="flat" Height="28" MinHeight="28" Padding="10,0" FontSize="12" Content="Restore…"
                  Click="OnApplySelectedStash" IsEnabled="{Binding SelectedStash, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="Restore the selected stash; opens restore options"/>
          <Button Grid.Column="4" Classes="icon_button" Width="28" Height="28" ToolTip.Tip="Stash options">
            <Path Width="15" Height="15" Data="{StaticResource Icons.More}"/>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Clear all stashes…" Command="{Binding ClearStashes}"
                          IsEnabled="{Binding Stashes, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
        <TextBox Height="28" Margin="12,0,10,0" BorderThickness="1" CornerRadius="8" FontSize="12"
                 Text="{Binding SearchFilter, Mode=TwoWay}" Watermark="Filter stashes"
                 BorderBrush="{DynamicResource Brush.Border2}" VerticalContentAlignment="Center">
          <TextBox.InnerLeftContent>
            <Path Width="12" Height="12" Margin="9,0,2,0" Fill="{DynamicResource Brush.FG3}" Data="{StaticResource Icons.Search}"/>
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Classes="icon_button" Focusable="False" Width="22" Margin="0,0,2,0" Command="{Binding ClearSearchFilter}"
                    IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" ToolTip.Tip="Clear filter">
              <Path Width="10" Height="10" Data="{StaticResource Icons.Clear}"/>
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>
      </Border>

      <Grid Grid.Row="2">
        <ListBox Background="{DynamicResource Brush.Contents}" ItemsSource="{Binding VisibleStashes}"
                 SelectedItem="{Binding SelectedStash, Mode=TwoWay}" SelectionMode="Single" KeyDown="OnStashListKeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Margin" Value="0"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Height" Value="52"/>
              <Setter Property="CornerRadius" Value="0"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Vertical"/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="m:Stash">
              <Border Background="Transparent" BorderBrush="{DynamicResource Brush.Border0}" BorderThickness="0,0,0,1" Padding="16,6"
                      ContextRequested="OnStashContextRequested" DoubleTapped="OnStashDoubleTapped" ToolTip.Tip="{Binding Message}">
                <Grid RowDefinitions="18,*">
                  <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Accent}" FontSize="11"/>
                    <v:DateTimePresenter Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right" FontSize="11"
                                         Timestamp="{Binding Time}" Foreground="{DynamicResource Brush.FG2}" FontFeatures="+tnum"/>
                  </Grid>
                  <v:StashSubjectPresenter Grid.Row="1" Subject="{Binding Subject}" Foreground="{DynamicResource Brush.FG1}"
                                           FontSize="13" PrefixBackground="{DynamicResource Brush.InlineCode}" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="No stashes to show" Foreground="{DynamicResource Brush.FG2}" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                   IsVisible="{Binding VisibleStashes, Converter={x:Static c:ListConverters.IsNullOrEmpty}}"/>
      </Grid>

      <Border Grid.Row="3" BorderThickness="0,1" BorderBrush="{DynamicResource Brush.Border0}">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center">
          <TextBlock Classes="eyebrow" Text="FILES IN THIS STASH"/>
          <TextBlock Classes="eyebrow" Text="{Binding Changes, Converter={x:Static c:ListConverters.ToCount}, Mode=OneWay}"/>
        </StackPanel>
      </Border>

      <Grid Grid.Row="4" Background="{DynamicResource Brush.Contents}">
        <v:ChangeCollectionView ViewMode="Tree" FontSize="13" Margin="8,0,2,0"
                                EnableCompactFolders="{Binding Source={x:Static vm:Preferences.Instance}, Path=EnableCompactFoldersInChangesTree}"
                                Changes="{Binding Changes, Mode=OneWay}" Selection="{Binding ChangeSelection, Mode=TwoWay}"
                                ContextRequested="OnChangeContextRequested" KeyDown="OnChangeCollectionViewKeyDown"/>
        <TextBlock Text="No files to show" Foreground="{DynamicResource Brush.FG2}" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                   IsVisible="{Binding Changes, Converter={x:Static c:ListConverters.IsNullOrEmpty}}"/>
      </Grid>
    </Grid>

    <GridSplitter Grid.Column="1" MinWidth="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Background="Transparent" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Brush.Border0}" Focusable="False"/>

    <Grid Grid.Column="2" Margin="4">
      <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding DiffContext, Converter={x:Static ObjectConverters.IsNull}}">
        <Path Width="24" Height="24" Data="{StaticResource Icons.Stashes}" Fill="{DynamicResource Brush.FG3}"/>
        <TextBlock Text="Select a stash" Foreground="{DynamicResource Brush.FG2}"
                   IsVisible="{Binding SelectedStash, Converter={x:Static ObjectConverters.IsNull}}"/>
        <TextBlock Text="Select a file" Foreground="{DynamicResource Brush.FG2}"
                   IsVisible="{Binding SelectedStash, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </StackPanel>
      <ContentControl Content="{Binding DiffContext}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:DiffContext"><v:DiffView/></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>
  </Grid>
</UserControl>

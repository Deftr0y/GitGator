<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:SourceGit.Converters"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.Welcome"
             x:DataType="vm:Welcome">
  <UserControl.Styles>
    <Style Selector="Button.home_action">
      <Setter Property="Height" Value="84"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="{DynamicResource Brush.SubPanel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Button.home_action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.BackgroundHovered}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Button.home_action:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Button.home_primary">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrush}"/>
    </Style>
    <Style Selector="Button.home_primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="*,Auto" Margin="24,12,24,16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*"/>
      <ColumnDefinition Width="3*" MinWidth="680" MaxWidth="800"/>
      <ColumnDefinition Width="1*"/>
    </Grid.ColumnDefinitions>

    <!-- Managed Repositories -->
    <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*">
      <!-- App identity -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,24,0,24"
                  HorizontalAlignment="Center" Spacing="10">
        <Image Width="72" Height="72" Source="/Resources/Images/gitgator.png"/>
        <TextBlock FontWeight="SemiBold" FontSize="40" VerticalAlignment="Center">
          <Run Text="Git"/><Run Text="Gator" Foreground="{StaticResource Brush.BrandOrange}"/>
        </TextBlock>
      </StackPanel>

      <!-- Everyday actions live in the new tab, above the saved repository list. -->
      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,0,0,24">
        <Button Grid.Column="0" x:Name="CloneRepositoryButton" Classes="home_action" Command="{Binding Clone}"
                ToolTip.Tip="Clone a repository · Ctrl+R" AutomationProperties.Name="Clone repository">
          <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
            <Path Width="24" Height="24" Data="{StaticResource Icons.Clone}" Fill="{DynamicResource Brush.Accent}"/>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Clone repository" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock Text="From a remote URL" FontSize="11" Foreground="{DynamicResource Brush.FG2}"/>
            </StackPanel>
          </Grid>
        </Button>
        <Button Grid.Column="1" x:Name="OpenRepositoryButton" Classes="home_action home_primary" Command="{Binding OpenLocalRepository}"
                ToolTip.Tip="Open a local folder · Ctrl+L" AutomationProperties.Name="Open repository">
          <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
            <Path Width="24" Height="24" Data="{StaticResource Icons.Folder.Open}" Fill="White"/>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Open repository" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock Text="Choose a local folder" FontSize="11" Foreground="White" Opacity="0.8"/>
            </StackPanel>
          </Grid>
        </Button>
        <Button Grid.Column="2" x:Name="OpenTerminalButton" Classes="home_action" Command="{Binding OpenTerminal}"
                ToolTip.Tip="Open a terminal · Ctrl+`" AutomationProperties.Name="Open terminal">
          <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
            <Path Width="24" Height="24" Data="{StaticResource Icons.Terminal}" Fill="{DynamicResource Brush.Accent}"/>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Open terminal" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock Text="Use the command line" FontSize="11" Foreground="{DynamicResource Brush.FG2}"/>
            </StackPanel>
          </Grid>
        </Button>
      </Grid>

      <!-- Search Box -->
      <TextBox Grid.Row="2"
               x:Name="SearchBox"
               Height="36"
               Padding="0"
               CornerRadius="6"
               BorderBrush="{DynamicResource Brush.Border0}"
               BorderThickness="1"
               Background="{DynamicResource Brush.Contents}"
               Watermark="{DynamicResource Text.Welcome.Search}"
               VerticalContentAlignment="Center"
               Text="{Binding SearchFilter, Mode=TwoWay}">
        <TextBox.InnerLeftContent>
          <Path Width="16" Height="16" Margin="6,0,3,0" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG2}"/>
        </TextBox.InnerLeftContent>

        <TextBox.InnerRightContent>
          <StackPanel Orientation="Horizontal">
            <!-- Invisible Button to handle search hotkey pressed-->
            <Button Width="0" Height="0"
                    Margin="0" Padding="0"
                    Click="OnSearchHotKey"
                    HotKey="{OnPlatform Ctrl+F, macOS=⌘+F}"/>

            <Button Classes="icon_button" IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Click="OnClearSearchFilter">
              <Path Width="16" Height="16" Margin="0,0,0,0" Data="{StaticResource Icons.Clear}" Fill="{DynamicResource Brush.FG1}"/>
            </Button>
          </StackPanel>
        </TextBox.InnerRightContent>
      </TextBox>

      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,16,0,3">
        <TextBlock Text="Repositories" FontWeight="SemiBold" Foreground="{DynamicResource Brush.FG2}"/>
        <Button Grid.Column="1" Classes="icon_button" Width="26" Height="24" ToolTip.Tip="Repository list options">
          <Path Width="14" Height="14" Data="{StaticResource Icons.More}"/>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{DynamicResource Text.Welcome.AddRootFolder}" Command="{Binding AddRootNode}"/>
              <MenuItem Header="{DynamicResource Text.Welcome.ScanDefaultCloneDir}" Command="{Binding ScanDefaultCloneDir}"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <!-- Repository Tree -->
      <v:RepositoryListBox Grid.Row="4"
                           x:Name="TreeContainer"
                           Margin="0,3,0,0"
                           Focusable="True"
                           Background="Transparent"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ItemsSource="{Binding Rows}"
                           SelectionMode="Single"
                           LostFocus="OnTreeViewLostFocus"
                           DragDrop.AllowDrop="True"
                           DragDrop.DragOver="DragOverTreeView"
                           DragDrop.Drop="DropOnTreeView">
        <ListBox.Styles>
          <Style Selector="ListBox">
            <Setter Property="FocusAdorner">
              <FocusAdornerTemplate>
                <Border Background="Transparent" BorderThickness="0"/>
              </FocusAdornerTemplate>
            </Setter>
          </Style>

          <Style Selector="ListBoxItem" x:DataType="vm:RepositoryNode">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FocusAdorner">
              <FocusAdornerTemplate>
                <Border Background="Transparent" BorderThickness="0"/>
              </FocusAdornerTemplate>
            </Setter>
          </Style>
        </ListBox.Styles>

        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Vertical"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{DynamicResource Text.Welcome.AddRootFolder}" Command="{Binding AddRootNode}">
              <MenuItem.Icon>
                <Path Width="12" Height="12" Data="{DynamicResource Icons.Folder.Add}"/>
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </ListBox.ContextMenu>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:RepositoryNode">
            <Grid Background="Transparent"
                  Height="30"
                  ColumnDefinitions="16,18,*,Auto,8"
                  Margin="{Binding Depth, Converter={x:Static c:IntConverters.ToTreeMargin}}"
                  ClipToBounds="True"
                  ContextRequested="OnTreeNodeContextRequested"
                  PointerPressed="OnPointerPressedTreeNode"
                  PointerMoved="OnPointerMovedOverTreeNode"
                  PointerReleased="OnPointerReleasedOnTreeNode"
                  DoubleTapped="OnDoubleTappedTreeNode"
                  DragDrop.AllowDrop="True"
                  DragDrop.DragOver="DragOverTreeNode"
                  DragDrop.Drop="DropOnTreeNode">
              <v:RepositoryTreeNodeToggleButton Grid.Column="0"
                                                Classes="tree_expander"
                                                Focusable="False"
                                                HorizontalAlignment="Center"
                                                IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                                IsVisible="{Binding !IsRepository}"/>

              <v:Bookmark Grid.Column="1"
                          Width="14" Height="14"
                          HorizontalAlignment="Center"
                          Value="{Binding Bookmark, Mode=OneWay}"
                          IsVisible="{Binding IsRepository}"/>

              <ToggleButton Grid.Column="1"
                            Classes="folder"
                            Focusable="False"
                            Width="14" Height="14"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource Brush.FG1}"
                            IsChecked="{Binding IsExpanded}"
                            IsVisible="{Binding !IsRepository}"/>

              <StackPanel Grid.Column="2" Orientation="Horizontal" ClipToBounds="True">
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Id, StringFormat=({0}), Converter={x:Static c:PathConverters.RelativeToHome}}">
                  <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="IsRepository"/>
                      <Binding Path="IsInvalid" Converter="{x:Static BoolConverters.Not}"/>
                    </MultiBinding>
                  </TextBlock.IsVisible>
                </TextBlock>
                <Path Margin="2,0,0,0"
                      Width="12" Height="12"
                      Data="{StaticResource Icons.Error}"
                      Fill="Orange"
                      IsVisible="{Binding IsInvalid}"/>
              </StackPanel>

              <ContentControl Grid.Column="3"
                              Margin="6,0,0,0"
                              Content="{Binding Status, Mode=OneWay}"
                              IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="m:RepositoryStatus">
                    <StackPanel Orientation="Horizontal">
                      <Border Margin="3,0"
                              Height="18"
                              CornerRadius="9"
                              Padding="6,0"
                              Background="{DynamicResource Brush.FG1}"
                              VerticalAlignment="Center"
                              IsVisible="{Binding LocalChanges, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                        <TextBlock Text="{Binding LocalChanges}"
                                   FontFamily="{DynamicResource Fonts.Monospace}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.Window}"/>
                      </Border>

                      <TextBlock Margin="3,0"
                                 Text="{Binding TrackingDescription}"
                                 FontFamily="{DynamicResource Fonts.Monospace}"
                                 FontSize="12"
                                 IsVisible="{Binding IsTrackingStatusVisible}"/>

                      <Border Margin="3,0,0,0"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource Brush.FG2}"
                              Height="20"
                              CornerRadius="4"
                              Padding="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Path Width="12" Height="12" Data="{StaticResource Icons.Branch}"/>
                          <TextBlock Margin="2,0,0,0" Text="{Binding CurrentBranch}" FontSize="12"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </v:RepositoryListBox>
      <TextBlock Grid.Row="4" Text="No repositories to show" Foreground="{DynamicResource Brush.FG2}"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" IsHitTestVisible="False"
                 IsVisible="{Binding Rows.Count, Converter={x:Static c:IntConverters.IsZero}}"/>

    </Grid>

    <!-- Tips -->
    <Border Grid.Row="1" Grid.Column="1"
            Margin="0,8,0,0"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            IsVisible="{OnPlatform True, Linux=False}">
      <TextBlock Classes="italic"
                 FontSize="12"
                 Text="{DynamicResource Text.Welcome.DragDropTip}"
                 Opacity=".5"/>
    </Border>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="SourceGit.Views.WorkingCopy"
             x:DataType="vm:WorkingCopy">
  <UserControl.Styles>
    <Style Selector="Button.workspace_action">
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="ToggleButton.preview_toggle">
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="7,0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="ToggleButton.preview_toggle:checked">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="TextBlock.workspace_count">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
    </Style>
  </UserControl.Styles>

  <Grid x:Name="MainLayout" ColumnDefinitions="*,0,0" SizeChanged="OnMainLayoutSizeChanged" Background="{DynamicResource Brush.Contents}">
    <!-- The workspace is one full-width stack until preview is explicitly enabled. -->
    <Grid Grid.Column="0" Background="{DynamicResource Brush.Window}" RowDefinitions="1.35*,4,*,Auto" MinWidth="360">
      <Grid Grid.Row="0" RowDefinitions="62,Auto,*" MinHeight="106">
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
          <Grid RowDefinitions="32,30">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="10,0,6,0" ColumnSpacing="4">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Changes" FontWeight="SemiBold"/>
              <TextBlock Classes="workspace_count" Text="{Binding UnstagedCountInfo}" VerticalAlignment="Center"/>
              <v:LoadingIcon Width="12" Height="12" IsVisible="{Binding IsStaging}"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="StageSelectedButton" Classes="flat workspace_action" Content="Stage" Click="OnStageSelectedButtonClicked"
                    IsEnabled="{Binding SelectedUnstaged.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"
                    ToolTip.Tip="Stage selected files or folders · Space / Enter"/>
            <Button Grid.Column="3" x:Name="StageAllButton" Classes="flat workspace_action" Content="Stage all" Click="OnStageAllButtonClicked"
                    IsEnabled="{Binding VisibleUnstaged.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"
                    HotKey="{OnPlatform Ctrl+Shift+S, macOS=⌘+Shift+S}" ToolTip.Tip="Stage all files shown by the current filter"/>
            <Button Grid.Column="4" Classes="icon_button" Width="24" Height="24" ToolTip.Tip="Change options">
              <Path Width="14" Height="14" Data="{StaticResource Icons.More}"/>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel MinWidth="210" Spacing="9" Margin="4">
                    <TextBlock Text="Change options" FontWeight="SemiBold"/>
                    <CheckBox Content="Show new files" IsChecked="{Binding IncludeUntracked, Mode=TwoWay}"/>
                    <Button Classes="flat workspace_action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Content="Manage ignored local edits…" Click="OnOpenAssumeUnchanged"/>
                    <Separator/>
                    <Button Classes="flat workspace_action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Content="Discard changes…" Command="{Binding DiscardAllChanges}"/>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="10,0,6,5" ColumnSpacing="6">
            <TextBox Grid.Column="0" x:Name="LocalChangesSearchBox" Height="24" MinWidth="40"
                     VerticalAlignment="Center" CornerRadius="4" FontSize="11"
                     Text="{Binding Filter, Mode=TwoWay}" Watermark="Filter files" VerticalContentAlignment="Center">
              <TextBox.InnerLeftContent>
                <Path Width="11" Height="11" Margin="7,0,2,0" Fill="{DynamicResource Brush.FG2}" Data="{StaticResource Icons.Search}"/>
              </TextBox.InnerLeftContent>
              <TextBox.InnerRightContent>
                <Button Classes="icon_button" Focusable="False" Width="20" Command="{Binding ClearFilter}" ToolTip.Tip="Clear filter"
                        IsVisible="{Binding Filter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <Path Width="10" Height="10" Data="{StaticResource Icons.Clear}"/>
                </Button>
              </TextBox.InnerRightContent>
            </TextBox>
            <ToggleButton Grid.Column="1" x:Name="PreviewToggle" Classes="preview_toggle" IsChecked="{Binding IsPreviewVisible, Mode=TwoWay}"
                          ToolTip.Tip="Show or hide file preview">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Width="12" Height="12" Data="{StaticResource Icons.Eye}"/>
                <TextBlock Text="Preview file" FontSize="11"/>
              </StackPanel>
            </ToggleButton>
          </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="1" Padding="10,4" Background="{DynamicResource Brush.Conflict.TheirsBG}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}" IsVisible="{Binding HasUnsolvedConflicts}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Conflict}" Fill="{DynamicResource Brush.Conflict}"/>
            <TextBlock Grid.Column="1" Text="Unresolved conflicts" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Classes="flat workspace_action" Content="Resolve" Command="{Binding ResolveConflicts}"/>
            <Button Grid.Column="3" Classes="flat workspace_action" Content="Merge tool" Click="OnOpenExternalMergeToolAllConflicts"/>
          </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,2,0,0">
          <v:ChangeCollectionView x:Name="UnstagedChangesView" IsUnstagedChange="True" Background="Transparent" ViewMode="Tree" FontSize="12"
                                  EnableCompactFolders="{Binding Source={x:Static vm:Preferences.Instance}, Path=EnableCompactFoldersInChangesTree}"
                                  Changes="{Binding VisibleUnstaged}" Selection="{Binding SelectedUnstaged, Mode=TwoWay}"
                                  ContextRequested="OnUnstagedContextRequested" ChangeDoubleTapped="OnUnstagedChangeDoubleTapped" KeyDown="OnUnstagedKeyDown"/>
          <TextBlock Classes="workspace_count" Text="No unstaged files" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                     IsVisible="{Binding VisibleUnstaged.Count, Converter={x:Static c:IntConverters.IsZero}}"/>
        </Grid>
      </Grid>

      <GridSplitter Grid.Row="1" MinHeight="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{DynamicResource Brush.Border0}" Focusable="False"/>

      <Grid Grid.Row="2" RowDefinitions="34,*" MinHeight="96">
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="10,0,6,0" ColumnSpacing="4">
            <TextBlock Text="Staged Changes" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Classes="workspace_count" Text="{Binding StagedCountInfo}" Margin="2,0,0,0" VerticalAlignment="Center"/>
            <v:LoadingIcon Grid.Column="2" Width="12" Height="12" Margin="6,0" HorizontalAlignment="Left" IsVisible="{Binding IsUnstaging}"/>
            <Button Grid.Column="3" x:Name="UnstageSelectedButton" Classes="flat workspace_action" Content="Unstage" Click="OnUnstageSelectedButtonClicked"
                    IsEnabled="{Binding SelectedStaged.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"
                    ToolTip.Tip="Unstage selected files or folders · Space / Enter"/>
            <Button Grid.Column="4" x:Name="UnstageAllButton" Classes="flat workspace_action" Content="Unstage all" Click="OnUnstageAllButtonClicked"
                    IsEnabled="{Binding VisibleStaged.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"
                    HotKey="{OnPlatform Ctrl+Shift+U, macOS=⌘+Shift+U}" ToolTip.Tip="Unstage all files shown by the current filter"/>
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,2,0,0">
          <v:ChangeCollectionView x:Name="StagedChangesView" IsUnstagedChange="False" Background="Transparent" ViewMode="Tree" FontSize="12"
                                  EnableCompactFolders="{Binding Source={x:Static vm:Preferences.Instance}, Path=EnableCompactFoldersInChangesTree}"
                                  Changes="{Binding VisibleStaged}" Selection="{Binding SelectedStaged, Mode=TwoWay}"
                                  ContextRequested="OnStagedContextRequested" ChangeDoubleTapped="OnStagedChangeDoubleTapped" KeyDown="OnStagedKeyDown"/>
          <TextBlock Classes="workspace_count" Text="No staged files" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                     IsVisible="{Binding VisibleStaged.Count, Converter={x:Static c:IntConverters.IsZero}}"/>
        </Grid>
      </Grid>

      <Border Grid.Row="3" Padding="8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border2}">
        <Grid RowDefinitions="80,Auto" RowSpacing="6">
          <TextBox x:Name="CommitMessageEditor" Text="{Binding CommitMessage, Mode=TwoWay}" Watermark="Commit message"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="12" Padding="8"
                   FontFamily="{DynamicResource Fonts.Monospace}" CornerRadius="4"/>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" Classes="flat workspace_action" Content="Options" ToolTip.Tip="Commit options">
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedLeft">
                  <StackPanel MinWidth="225" Spacing="9" Margin="4">
                    <TextBlock Text="Commit options" FontWeight="SemiBold"/>
                    <CheckBox Content="{DynamicResource Text.WorkingCopy.SignOff}" IsChecked="{Binding EnableSignOff, Mode=TwoWay}"/>
                    <CheckBox Content="{DynamicResource Text.WorkingCopy.NoVerify}" IsChecked="{Binding NoVerifyOnCommit, Mode=TwoWay}" ToolTip.Tip="Skip the repository's commit hooks"/>
                    <CheckBox Content="Amend previous commit" IsChecked="{Binding UseAmend, Mode=TwoWay}"/>
                    <CheckBox Content="{DynamicResource Text.WorkingCopy.ResetAuthor}" IsChecked="{Binding ResetAuthor, Mode=TwoWay}" IsVisible="{Binding UseAmend}"/>
                    <Separator/>
                    <Button Classes="flat workspace_action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Content="Stage all files and commit…" Click="OnCommitWithAutoStage" ToolTip.Tip="Includes files hidden by the filter">
                      <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="IsCommitting" Converter="{x:Static BoolConverters.Not}"/>
                          <Binding Path="HasUnsolvedConflicts" Converter="{x:Static BoolConverters.Not}"/>
                          <Binding Path="CommitMessage" Converter="{x:Static c:StringConverters.IsNotNullOrWhitespace}"/>
                        </MultiBinding>
                      </Button.IsEnabled>
                    </Button>
                    <Button Classes="flat workspace_action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Create an empty commit…" Click="OnCommit">
                      <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="Staged.Count" Converter="{x:Static c:IntConverters.IsZero}"/>
                          <Binding Path="InProgressContext" Converter="{x:Static ObjectConverters.IsNull}"/>
                          <Binding Path="UseAmend" Converter="{x:Static BoolConverters.Not}"/>
                        </MultiBinding>
                      </Button.IsVisible>
                      <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="IsCommitting" Converter="{x:Static BoolConverters.Not}"/>
                          <Binding Path="HasUnsolvedConflicts" Converter="{x:Static BoolConverters.Not}"/>
                          <Binding Path="CommitMessage" Converter="{x:Static c:StringConverters.IsNotNullOrWhitespace}"/>
                        </MultiBinding>
                      </Button.IsEnabled>
                    </Button>
                    <Button Classes="flat workspace_action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Content="Commit current step with this message" Click="OnCommit"
                            IsVisible="{Binding InProgressContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="IsCommitting" Converter="{x:Static BoolConverters.Not}"/>
                          <Binding Path="HasUnsolvedConflicts" Converter="{x:Static BoolConverters.Not}"/>
                          <Binding Path="CommitMessage" Converter="{x:Static c:StringConverters.IsNotNullOrWhitespace}"/>
                        </MultiBinding>
                      </Button.IsEnabled>
                    </Button>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Classes="workspace_count" Text="Amending previous commit" Margin="0,0,12,0" IsVisible="{Binding UseAmend}"/>
              <TextBlock Classes="workspace_count" Text="Sign-off" Margin="0,0,12,0" IsVisible="{Binding EnableSignOff}"/>
              <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Conflict}" Text="Hooks skipped" IsVisible="{Binding NoVerifyOnCommit}"/>
            </WrapPanel>
            <v:LoadingIcon Grid.Column="2" Width="15" Height="15" IsVisible="{Binding IsCommitting}"/>
            <Button Grid.Column="3" Classes="flat primary" Height="30" MinHeight="30" MinWidth="140" CornerRadius="4" Padding="16,0"
                    Content="{DynamicResource Text.Repository.Continue}" Click="OnContinue"
                    IsVisible="{Binding InProgressContext, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Button.IsEnabled>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="IsCommitting" Converter="{x:Static BoolConverters.Not}"/>
                  <Binding Path="HasUnsolvedConflicts" Converter="{x:Static BoolConverters.Not}"/>
                </MultiBinding>
              </Button.IsEnabled>
            </Button>
            <Button Grid.Column="3" x:Name="CommitButton" Classes="flat primary" Height="30" MinHeight="30" MinWidth="140" CornerRadius="4" Padding="16,0"
                    Content="Commit staged" Click="OnCommit" HotKey="{OnPlatform Ctrl+Enter, macOS=⌘+Enter}"
                    IsVisible="{Binding InProgressContext, Converter={x:Static ObjectConverters.IsNull}}"
                    ToolTip.Tip="Commit staged files locally · Ctrl+Enter">
              <Button.IsEnabled>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="IsCommitting" Converter="{x:Static BoolConverters.Not}"/>
                  <Binding Path="HasUnsolvedConflicts" Converter="{x:Static BoolConverters.Not}"/>
                  <Binding Path="CommitMessage" Converter="{x:Static c:StringConverters.IsNotNullOrWhitespace}"/>
                  <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="Staged.Count" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/>
                    <Binding Path="UseAmend"/>
                  </MultiBinding>
                </MultiBinding>
              </Button.IsEnabled>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <GridSplitter Grid.Column="1" MinWidth="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="False"
                  IsVisible="{Binding IsPreviewVisible}" Background="{DynamicResource Brush.Border0}"/>
    <Grid Grid.Column="2" RowDefinitions="34,*" IsVisible="{Binding IsPreviewVisible}" Background="{DynamicResource Brush.Contents}">
      <Border Grid.Row="0" Padding="10,0,6,0" Background="{DynamicResource Brush.Window}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="File preview" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" x:Name="ClosePreviewButton" Classes="icon_button" Width="24" Height="24" Command="{Binding HidePreview}" ToolTip.Tip="Close preview">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Clear}"/>
          </Button>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <TextBlock Text="Select a file" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}"
                   IsVisible="{Binding DetailContext, Converter={x:Static ObjectConverters.IsNull}}"/>
        <ContentControl Content="{Binding DetailContext}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:Conflict"><v:Conflict/></DataTemplate>
            <DataTemplate DataType="vm:DiffContext"><v:DiffView/></DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Grid>
    </Grid>

    <Button Width="0" Height="0" Background="Transparent" Click="OnCommitWithAutoStage" HotKey="{OnPlatform Ctrl+Shift+Enter, macOS=⌘+Shift+Enter}">
      <Button.IsEnabled>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsCommitting" Converter="{x:Static BoolConverters.Not}"/>
          <Binding Path="HasUnsolvedConflicts" Converter="{x:Static BoolConverters.Not}"/>
          <Binding Path="CommitMessage" Converter="{x:Static c:StringConverters.IsNotNullOrWhitespace}"/>
        </MultiBinding>
      </Button.IsEnabled>
    </Button>
  </Grid>
</UserControl>
